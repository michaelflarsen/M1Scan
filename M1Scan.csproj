<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>M1Scan</RootNamespace>
    <AssemblyName>M1Scan</AssemblyName>
    <Version>1.3.61</Version>
    <Authors>Michael Larsen</Authors>
    <Company>Michael Larsen</Company>
    <Product>M1Scan</Product>
    <Description>Advanced Windows Network Utility - Network Scanning, IP Management, ARP/Ping</Description>
    <Copyright>© 2026 Michael Larsen</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Komprimerer indlejrede assemblies i single-file publish (~50 % mindre exe).
         Koster kun lidt ekstra opstartstid ved første udpakning. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Kun engelske (neutrale) resources — dropper lokaliserede satellit-DLL'er. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);M1Scan.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Giver testprojektet adgang til intern parsing-logik (fx
         NetworkService.ParsePtrAnswer), så pakke-parsere kan testes direkte
         uden at gøre dem til offentligt API. -->
    <InternalsVisibleTo Include="M1Scan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Themes\" />
    <Resource Include="app.ico" />
    <Resource Include="Resources\ntech-logo.png" />
    <Resource Include="Resources\m1scan-logo.jpg" />
    <Resource Include="Resources\m1scan-logo-small.jpg" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- IEEE MA-L OUI-tabel (~39.700 vendor-præfikser), gzip-komprimeret, indlejret i
         assemblyen så vendor-opslag altid virker uden en separat fil eller download.
         Se Utils/OuiLookup.cs. Regenerér med scripts/update-oui.py ved behov. -->
    <EmbeddedResource Include="Resources\Data\oui.txt.gz" LogicalName="M1Scan.Resources.Data.oui.txt.gz" />
  </ItemGroup>

</Project>
