<Window x:Class="M1Scan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:utils="clr-namespace:M1Scan.Utils"
        xmlns:views="clr-namespace:M1Scan.Views"
        mc:Ignorable="d"
        Title="M1Scan" Height="760" Width="1400" MinWidth="1100" MinHeight="600"
        Icon="/app.ico"
        Background="{StaticResource DarkBackgroundBrush}">

    <Window.Resources>

        <!-- Sidebar nav RadioButton style -->
        <Style x:Key="SideNavStyle" TargetType="RadioButton">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="#777777"/>
            <Setter Property="BorderBrush"               Value="Transparent"/>
            <Setter Property="BorderThickness"           Value="3,0,0,0"/>
            <Setter Property="Padding"                   Value="16,11"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#1B2D44"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#1565C0"/>
                                <Setter Property="Foreground"                   Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsEnabled"   Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="#141E2C"/>
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar section header -->
        <Style x:Key="SideNavHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#444444"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="19,14,0,2"/>
        </Style>

        <!-- Stats card value -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Stats card label -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin"    Value="0,2,0,0"/>
        </Style>

        <!-- Zoom button style -->
        <Style x:Key="ZoomBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#7A9EC0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3050"/>
                                <Setter Property="Foreground" Value="#C8E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#1E2C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Adapter dropdown button -->
        <Style x:Key="AdapterDropdownStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root: sidebar (200px) + content (*) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!--  SIDEBAR                                                      -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="#0D1117">
            <DockPanel LastChildFill="True">

                <!-- Logo / brand header -->
                <Border DockPanel.Dock="Top" Padding="0,16,0,12" Background="#07030d">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Radar icon — pure WPF geometry, 60×60 -->
                        <Viewbox Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Canvas Width="60" Height="60">

                                <!-- Pie slice fill -->
                                <Path Fill="#e0337a" Opacity="0.13">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="30,30" IsClosed="True">
                                                <LineSegment Point="43.6,9.0"/>
                                                <ArcSegment Point="51.0,16.4" Size="25,25"
                                                            SweepDirection="Clockwise" IsLargeArc="False"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Crosshair horizontal -->
                                <Line X1="5" Y1="30" X2="55" Y2="30"
                                      Stroke="#e0337a" StrokeThickness="0.5" Opacity="0.15"/>
                                <!-- Crosshair vertical -->
                                <Line X1="30" Y1="5" X2="30" Y2="55"
                                      Stroke="#e0337a" StrokeThickness="0.5" Opacity="0.15"/>

                                <!-- Outer circle r=25 -->
                                <Ellipse Canvas.Left="5"  Canvas.Top="5"  Width="50" Height="50"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.3"/>
                                <!-- Mid circle r=17 -->
                                <Ellipse Canvas.Left="13" Canvas.Top="13" Width="34" Height="34"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.5"/>
                                <!-- Inner circle r=10 -->
                                <Ellipse Canvas.Left="20" Canvas.Top="20" Width="20" Height="20"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.6"/>

                                <!-- Sweep line — upper-right direction -->
                                <Line X1="30" Y1="30" X2="48" Y2="12"
                                      Stroke="#e0337a" StrokeThickness="2"/>

                                <!-- Center dot -->
                                <Ellipse Canvas.Left="27.5" Canvas.Top="27.5" Width="5" Height="5"
                                         Fill="#e0337a"/>

                                <!-- Ping dot 1 — near inner ring, upper-left -->
                                <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.95"/>
                                <!-- Ping dot 2 — near mid ring, right -->
                                <Ellipse Canvas.Left="44.5" Canvas.Top="26.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.6"/>
                                <!-- Ping dot 3 — near outer ring, lower-right -->
                                <Ellipse Canvas.Left="41.5" Canvas.Top="44.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.4"/>

                            </Canvas>
                        </Viewbox>

                        <!-- M1Scan logotype -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="M1"   FontFamily="Inter, Segoe UI, Arial" FontSize="20"
                                       FontWeight="ExtraBold" Foreground="#e0337a" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan" FontFamily="Inter, Segoe UI, Arial" FontSize="20"
                                       FontWeight="Light"     Foreground="White"    VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tagline -->
                        <TextBlock Text="NETWORK DISCOVERY"
                                   FontFamily="Inter, Segoe UI, Arial" FontSize="9"
                                   Foreground="#e0337a" Opacity="0.8"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>

                        <!-- Version -->
                        <TextBlock x:Name="AppVersionText"
                                   FontSize="9" Foreground="#444444"
                                   HorizontalAlignment="Center"/>

                        <!-- Update available badge — skjult indtil UpdateVm.IsUpdateAvailable -->
                        <Border Margin="10,8,10,0" Padding="8,6"
                                Background="#1A0E22" CornerRadius="4"
                                BorderBrush="#e0337a" BorderThickness="1"
                                Visibility="{Binding UpdateVm.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateVm.StatusText}"
                                           FontSize="10" Foreground="#f06ab0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding UpdateVm.DownloadProgressPercent, Mode=OneWay}"
                                             Foreground="#4fc3f7" Background="#0C1420" BorderThickness="0"
                                             Margin="0,0,0,5"
                                             Visibility="{Binding UpdateVm.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Content="Update now"
                                        Command="{Binding UpdateVm.UpdateNowCommand}"
                                        Style="{StaticResource AdapterDropdownStyle}"
                                        Foreground="#e0337a" FontSize="10" FontWeight="SemiBold"
                                        Padding="6,4" HorizontalContentAlignment="Center"
                                        Visibility="{Binding UpdateVm.IsDownloading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Bottom buttons: Zoom + Adapters -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">

                    <!-- Zoom widget -->
                    <Border Padding="10,7,10,5"
                            Background="#0C1420"
                            BorderBrush="#1A2A40" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="// ZOOM" FontFamily="Consolas" FontSize="9"
                                       Foreground="#3A6A9A" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Border Background="#060D18" CornerRadius="5"
                                    BorderBrush="#1A3050" BorderThickness="1"
                                    Padding="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Zoom ud -->
                                    <Button x:Name="ZoomOutBtn" Grid.Column="0"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomOut_Click" ToolTip="Zoom ud (−)">
                                        <materialDesign:PackIcon Kind="MagnifyMinus" Width="17" Height="17"
                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>

                                    <!-- Reset / procent -->
                                    <Button x:Name="ZoomResetBtn" Grid.Column="1"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomReset_Click" ToolTip="Nulstil til 100%"
                                            MinWidth="46">
                                        <TextBlock x:Name="ZoomLabel" Text="100%"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   HorizontalAlignment="Center"/>
                                    </Button>

                                    <!-- Zoom ind -->
                                    <Button x:Name="ZoomInBtn" Grid.Column="2"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomIn_Click" ToolTip="Zoom ind (+)">
                                        <materialDesign:PackIcon Kind="MagnifyPlus" Width="17" Height="17"
                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#151E2C" Margin="16,4"/>

                    <RadioButton x:Name="AdaptersNavBtn"
                                 Style="{StaticResource SideNavStyle}"
                                 GroupName="SideNav" Tag="Adapters" Click="SideNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanCheck" Width="18" Height="18"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Adapters" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Scrollable nav -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,6,0,0">

                        <RadioButton x:Name="HomeNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" IsChecked="True"
                                     Tag="Dashboard" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="DevicesNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Tag="Scan" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Devices" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Scan" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="WorkspaceNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Tag="DeviceFollow" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CursorDefaultClick" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Device Follow" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TracerouteNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Click="SideNav_Click"
                                     Tag="Traceroute">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sitemap" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Traceroute" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="IpConfigNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="IpSkift" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="IpNetworkOutline" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="IP-skift" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="FindIpNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="FindIp" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Radar" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Find IP" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="MacAliasNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="MacAlias" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="MAC Aliases" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SideNavStyle}" IsEnabled="False"
                                     GroupName="SideNav">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccessPoint" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Ping monitor" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SideNavStyle}" IsEnabled="False"
                                     GroupName="SideNav">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Fingerprint" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Fingerprints" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SideNavStyle}" IsEnabled="False"
                                     GroupName="SideNav">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Historik" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  CONTENT AREA                                                 -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- TopBar -->
                <RowDefinition Height="Auto"/> <!-- Header (Scan/IP-skift) -->
                <RowDefinition Height="Auto"/> <!-- Stats row -->
                <RowDefinition Height="*"/>    <!-- Content panels -->
            </Grid.RowDefinitions>

            <!-- ===== TOP BAR (hidden on Workspace page) ===== -->
            <Border Grid.Row="0" Background="#0D1520" Padding="20,9,12,9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="DeviceFollow">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Scan">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Adapters">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="IpSkift">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Traceroute">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="FindIp">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="MacAlias">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>        <!-- Adapter dropdown button -->
                        <ColumnDefinition Width="Auto"/>        <!-- Subnet group -->
                        <ColumnDefinition Width="Auto"/>        <!-- Scan button -->
                        <ColumnDefinition Width="Auto"/>        <!-- Cancel button -->
                    </Grid.ColumnDefinitions>

                    <!-- Adapter dropdown button -->
                    <Button x:Name="AdapterDropdownButton"
                            Grid.Column="0"
                            Style="{StaticResource AdapterDropdownStyle}"
                            MinWidth="140" MaxWidth="300" Height="30"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            Click="AdapterDropdownButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding NetworkScanVm.SelectedAdapterLabel}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" Foreground="#CCCCCC"
                                       Margin="10,0,4,0"/>
                            <TextBlock Grid.Column="1" Text="▾"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="#666666" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- Subnet + scan range + action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="Subnet:" VerticalAlignment="Center"
                                   Foreground="#AAAAAA" FontSize="12" Margin="0,0,6,0"/>
                        <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="108" Height="30"
                                 Text="{Binding NetworkScanVm.SubnetInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="." VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                        <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                                 Text="{Binding NetworkScanVm.StartIp, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="–" VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                        <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                                 Text="{Binding NetworkScanVm.EndIp, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Auto-detect" Margin="6,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="30" Padding="6,0"
                                Command="{Binding NetworkScanVm.AutoDetectSubnetCommand}"/>
                        <Button Content="Clear" Margin="4,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="30" Padding="6,0"
                                Command="{Binding NetworkScanVm.ClearResultsCommand}"/>
                    </StackPanel>

                    <!-- Scan button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1565C0" BorderBrush="#1565C0"
                            Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                            Command="{Binding NetworkScanVm.ScanNetworkCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Radar" Width="15" Height="15"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Scan Network" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel (only visible while scanning) -->
                    <Button Grid.Column="3"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="30" VerticalAlignment="Center"
                            Command="{Binding NetworkScanVm.CancelScanCommand}"
                            Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cancel" Width="15" Height="15"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Annuller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== HEADER ROW (Scan & IP-skift pages) ===== -->
            <!-- Scan Header -->
            <Border Grid.Row="1" Background="{StaticResource DarkBackgroundBrush}" Padding="20,0,20,0" Margin="0,6,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Scan">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <materialDesign:Card Padding="16,12" Background="#1C2535" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Radar" Width="26" Height="26" Foreground="#4a90e2" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan — Aktiv netværksscanning" FontSize="24" FontWeight="Bold" Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="Scanner aktivt et helt subnet ved at pinge hver adresse i det valgte IP-interval og opdager alle enheder der svarer. For hver host vises IP, MAC-adresse, producent (vendor), TTL/OS-gæt og åbne porte (80/443/8080), så du hurtigt får et komplet overblik over hvad der er online på netværket."/>
                    </StackPanel>
                </materialDesign:Card>
            </Border>

            <!-- IP-skift Header -->
            <Border Grid.Row="1" Background="{StaticResource DarkBackgroundBrush}" Padding="20,0,20,0" Margin="0,6,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="IpSkift">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <materialDesign:Card Padding="16,12" Background="#1C2535" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="IpNetworkOutline" Width="26" Height="26" Foreground="#4a90e2" VerticalAlignment="Center"/>
                            <TextBlock Text="IP-skift — Skift mellem DHCP og statisk IP" FontSize="24" FontWeight="Bold" Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="Ændrer IP-konfigurationen på en valgt netværksadapter. Skift hurtigt til DHCP så adapteren automatisk får en adresse fra routeren, eller sæt en statisk IP med subnetmaske, gateway og DNS efter behov. Ændringerne udføres via netsh og kræver administratorrettigheder. Her kan du også rydde (flushe) DNS-cachen."/>
                    </StackPanel>
                </materialDesign:Card>
            </Border>

            <!-- ===== STATS ROW (Devices page only) ===== -->
            <Grid Grid.Row="2" x:Name="StatsRow"
                  Background="{StaticResource DarkBackgroundBrush}"
                  Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding NetworkScanVm.DiscoveredHosts.Count}"
                                   Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Devices found" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding OnlineCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource StatValue}" Foreground="#4CAF50"/>
                        <TextBlock Text="Online" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="2" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding OfflineCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource StatValue}" Foreground="#EF5350"/>
                        <TextBlock Text="Offline" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- NOT SCANNING: Show last scan time -->
                        <StackPanel Grid.Row="0" Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LastScanTime, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource StatValue}" FontSize="22"/>
                            <TextBlock Text="Last scanned" Style="{StaticResource StatLabel}"/>
                        </StackPanel>

                        <!-- NOT SCANNING: Show total scanning time -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                   Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="Total time: " FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding NetworkScanVm.ScanElapsedTime}"
                                       FontSize="11" FontFamily="Consolas" Foreground="#4a90e2" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- SCANNING: Show progress bar -->
                        <StackPanel Grid.Row="1" Orientation="Vertical"
                                   Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,6,0,0">
                            <!-- Header with scanning indicator -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Foreground="#4a90e2">
                                    <materialDesign:PackIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </materialDesign:PackIcon.Triggers>
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform CenterX="8" CenterY="8"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="SCANNING IN PROGRESS" FontSize="12" FontWeight="Bold"
                                          Foreground="#4a90e2" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Last scanned time during active scan -->
                            <TextBlock Text="{Binding LastScanTime, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Last Scanned: {0}'}"
                                      FontSize="10" Foreground="#666" Margin="0,0,0,6"/>


                            <!-- Progress bar (indeterminate animation) -->
                            <ProgressBar Height="4" Background="#2a3f5f" Foreground="#4a90e2" IsIndeterminate="True"/>

                            <!-- Status message -->
                            <TextBlock Text="{Binding NetworkScanVm.StatusMessage}" FontSize="11"
                                      Foreground="#aaa" Margin="0,6,0,0"/>

                            <!-- Timing info -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Elapsed: " FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="{Binding NetworkScanVm.ScanElapsedTime}"
                                              FontSize="10" FontFamily="Consolas" Foreground="#4a90e2" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text=" • " FontSize="10" Foreground="#555" Margin="4,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Est. remaining: " FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="{Binding NetworkScanVm.EstimatedTimeRemaining}"
                                              FontSize="10" FontFamily="Consolas" Foreground="#e24a4a" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- ============================================================ -->
            <!--  CONTENT PANELS                                               -->
            <!-- ============================================================ -->
            <Grid Grid.Row="3" Background="{StaticResource DarkBackgroundBrush}">

                <!-- ===================================================== -->
                <!--  HOME PANEL                                             -->
                <!-- ===================================================== -->
                <views:HomeView x:Name="HomePanel" Visibility="Collapsed"
                                DataContext="{Binding HomeVm}"/>

                <!-- ===================================================== -->
                <!--  DEVICES PANEL                                          -->
                <!-- ===================================================== -->
                <Grid x:Name="DevicesPanel"
                      DataContext="{Binding NetworkScanVm}"
                      Margin="20,6,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Scan bar -->
                    <Border Grid.Row="0" Background="#0D1520" CornerRadius="4" Padding="12,9" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DevicesAdapterDropdownButton"
                                    Grid.Column="0"
                                    Style="{StaticResource AdapterDropdownStyle}"
                                    MinWidth="200" MaxWidth="420" Height="30"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Click="AdapterDropdownButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedAdapterLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12" Foreground="#CCCCCC"
                                               Margin="10,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="#666666" FontSize="12"/>
                                </Grid>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="Subnet:" VerticalAlignment="Center"
                                           Foreground="#AAAAAA" FontSize="12" Margin="0,0,6,0"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="108" Height="30"
                                         Text="{Binding SubnetInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="." VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                                         Text="{Binding StartIp, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="–" VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                                         Text="{Binding EndIp, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Auto-detect" Margin="6,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" Padding="6,0"
                                        Command="{Binding AutoDetectSubnetCommand}"/>
                                <Button Content="Clear" Margin="4,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" Padding="6,0"
                                        Command="{Binding ClearResultsCommand}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#1565C0" BorderBrush="#1565C0"
                                    Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Command="{Binding ScanNetworkCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Radar" Width="15" Height="15"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Scan Network" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="30" VerticalAlignment="Center"
                                    Command="{Binding CancelScanCommand}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" Width="15" Height="15"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Annuller" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="5"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="30" VerticalAlignment="Center"
                                    ToolTip="Eksportér enhederne i listen til CSV eller JSON"
                                    Command="{Binding ExportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Export" Width="15" Height="15"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Eksportér" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search box -->
                    <TextBox Grid.Row="1" Margin="0,0,0,6" Height="30"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search IP, hostname, vendor…"
                             materialDesign:HintAssist.Foreground="#444444"/>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredHosts, RelativeSource={RelativeSource AncestorType=Window}}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource ControlBackgroundBrush}"
                              BorderBrush="{StaticResource ControlBorderBrush}"
                              BorderThickness="1"
                              RowHeight="28"
                              ColumnHeaderHeight="30"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="4,0,4,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                              Color="#0D47A1"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                          Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"             Color="#1A237E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"         Color="White"/>
                            <utils:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
                        </DataGrid.Resources>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"   Value="#151E2C"/>
                                <Setter Property="Foreground"   Value="#888888"/>
                                <Setter Property="Padding"      Value="6,0"/>
                                <Setter Property="FontSize"     Value="11"/>
                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource ControlBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DarkForegroundBrush}"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Ping denne host"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.PingHostCommand}"
                                                      CommandParameter="{Binding IpAddress}"/>
                                            <MenuItem Header="Kopier IP"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.CopyIpCommand}"
                                                      CommandParameter="{Binding IpAddress}"/>
                                            <MenuItem Header="Kopier MAC"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.CopyMacCommand}"
                                                      CommandParameter="{Binding MacAddress}"/>
                                            <Separator/>
                                            <MenuItem Header="Åbn :80 i browser"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                      CommandParameter="{Binding Url80}"
                                                      IsEnabled="{Binding IsPort80Open}"/>
                                            <MenuItem Header="Åbn :443 i browser"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                      CommandParameter="{Binding Url443}"
                                                      IsEnabled="{Binding IsPort443Open}"/>
                                            <MenuItem Header="Åbn :8080 i browser"
                                                      Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                      CommandParameter="{Binding Url8080}"
                                                      IsEnabled="{Binding IsPort8080Open}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReachable}" Value="True">
                                        <Setter Property="Background" Value="#121F12"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReachable}" Value="False">
                                        <Setter Property="Background" Value="#1F1212"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D2D3D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- IP address -->
                            <DataGridTemplateColumn Header="IP address" SortMemberPath="IpSortValue" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="None">
                                            <Hyperlink Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding IpAddress}"
                                                       Foreground="#64B5F6"
                                                       TextDecorations="None">
                                                <Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hostname — stretches with window -->
                            <DataGridTextColumn Header="Hostname" Binding="{Binding HostName}" Width="2*" MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"     Value="{StaticResource DarkForegroundBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming"   Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- MAC address -->
                            <DataGridTextColumn Header="MAC address" Binding="{Binding MacAddress}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"     Value="#888888"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily"     Value="Consolas"/>
                                        <Setter Property="FontSize"       Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Vendor -->
                            <DataGridTemplateColumn Header="Vendor" Width="210" SortMemberPath="Vendor">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="vnd" Text="{Binding Vendor}"
                                                   Foreground="{StaticResource DarkForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding OriginalVendor}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Vendor}" Value="">
                                                <Setter TargetName="vnd" Property="Text"       Value="—"/>
                                                <Setter TargetName="vnd" Property="Foreground" Value="#3A3A3A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAlias}" Value="True">
                                                <Setter TargetName="vnd" Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- :80 chip -->
                            <DataGridTemplateColumn Header=":80" Width="40" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="40" HorizontalAlignment="Center"
                                                BorderThickness="0" Padding="3,2"
                                                FontFamily="Consolas" FontSize="11"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                CommandParameter="{Binding Url80}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#222222"/>
                                                    <Setter Property="Foreground" Value="#444444"/>
                                                    <Setter Property="Cursor"     Value="Arrow"/>
                                                    <Setter Property="IsEnabled"  Value="False"/>
                                                    <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="txt" Text=":80"
                                                                               FontFamily="{TemplateBinding FontFamily}"
                                                                               FontSize="{TemplateBinding FontSize}"
                                                                               FontWeight="{TemplateBinding FontWeight}"
                                                                               Foreground="{TemplateBinding Foreground}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                            <Condition Property="IsEnabled"   Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="Bd"  Property="Background" Value="#0A303A"/>
                                                                        <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPort80Open}" Value="True">
                                                            <Setter Property="IsEnabled"  Value="True"/>
                                                            <Setter Property="Cursor"     Value="Hand"/>
                                                            <Setter Property="Background" Value="#0A2028"/>
                                                            <Setter Property="Foreground" Value="#00BCD4"/>
                                                            <Setter Property="ToolTip"    Value="Åbn i browser (http)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- :443 chip -->
                            <DataGridTemplateColumn Header=":443" Width="48" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="40" HorizontalAlignment="Center"
                                                BorderThickness="0" Padding="3,2"
                                                FontFamily="Consolas" FontSize="11"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                CommandParameter="{Binding Url443}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#222222"/>
                                                    <Setter Property="Foreground" Value="#444444"/>
                                                    <Setter Property="Cursor"     Value="Arrow"/>
                                                    <Setter Property="IsEnabled"  Value="False"/>
                                                    <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="txt" Text=":443"
                                                                               FontFamily="{TemplateBinding FontFamily}"
                                                                               FontSize="{TemplateBinding FontSize}"
                                                                               FontWeight="{TemplateBinding FontWeight}"
                                                                               Foreground="{TemplateBinding Foreground}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                            <Condition Property="IsEnabled"   Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="Bd"  Property="Background" Value="#221040"/>
                                                                        <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPort443Open}" Value="True">
                                                            <Setter Property="IsEnabled"  Value="True"/>
                                                            <Setter Property="Cursor"     Value="Hand"/>
                                                            <Setter Property="Background" Value="#1A0C30"/>
                                                            <Setter Property="Foreground" Value="#CE93D8"/>
                                                            <Setter Property="ToolTip"    Value="Åbn i browser (https)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- :8080 chip -->
                            <DataGridTemplateColumn Header=":8080" Width="54" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="46" HorizontalAlignment="Center"
                                                BorderThickness="0" Padding="3,2"
                                                FontFamily="Consolas" FontSize="11"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                                CommandParameter="{Binding Url8080}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#222222"/>
                                                    <Setter Property="Foreground" Value="#444444"/>
                                                    <Setter Property="Cursor"     Value="Arrow"/>
                                                    <Setter Property="IsEnabled"  Value="False"/>
                                                    <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="txt" Text=":8080"
                                                                               FontFamily="{TemplateBinding FontFamily}"
                                                                               FontSize="{TemplateBinding FontSize}"
                                                                               FontWeight="{TemplateBinding FontWeight}"
                                                                               Foreground="{TemplateBinding Foreground}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                            <Condition Property="IsEnabled"   Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="Bd"  Property="Background" Value="#341222"/>
                                                                        <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPort8080Open}" Value="True">
                                                            <Setter Property="IsEnabled"  Value="True"/>
                                                            <Setter Property="Cursor"     Value="Hand"/>
                                                            <Setter Property="Background" Value="#280E1A"/>
                                                            <Setter Property="Foreground" Value="#F06292"/>
                                                            <Setter Property="ToolTip"    Value="Åbn i browser (port 8080)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Other ports (badge) -->
                            <DataGridTemplateColumn Header="Other" Width="65" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#261A38" CornerRadius="10" Padding="7,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsPort502Open, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding OtherPorts}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#CE93D8"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ping ms -->
                            <DataGridTextColumn Header="ms" Binding="{Binding ResponseTime}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"          Value="#666666"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ===================================================== -->
                <!--  ADAPTERS PANEL                                         -->
                <!-- ===================================================== -->
                <Grid x:Name="AdaptersPanel" Visibility="Collapsed"
                      Margin="20,10,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Refresh Adapters"
                            Style="{StaticResource DarkButtonStyle}"
                            Margin="0,0,0,10" Width="150" HorizontalAlignment="Left"
                            Command="{Binding RefreshAdaptersCommand}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="#2A6034" BorderThickness="1" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Aktive adaptere" FontWeight="SemiBold"
                                               Foreground="#6FCF97" Margin="0,0,0,6"/>
                                    <DataGrid ItemsSource="{Binding ActiveAdapters}"
                                              SelectedItem="{Binding SelectedAdapter}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="{StaticResource ControlBackgroundBrush}">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0D47A1"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A237E"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Navn"       Binding="{Binding Name}"           Width="*"/>
                                            <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}"  Width="2*"/>
                                            <DataGridTextColumn Header="IP-adresse" Binding="{Binding IpAddresses[0]}" Width="150"/>
                                            <DataGridTextColumn Header="MAC-adresse" Binding="{Binding MacAddress}"   Width="150"/>
                                            <DataGridTextColumn Header="IP-tilstand" Binding="{Binding DhcpText}"     Width="90"/>
                                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"         Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#5C2A2A" BorderThickness="1" CornerRadius="4"
                                    Padding="10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Inaktive adaptere" FontWeight="SemiBold"
                                               Foreground="#EB5757" Margin="0,0,0,6"/>
                                    <DataGrid ItemsSource="{Binding InactiveAdapters}"
                                              SelectedItem="{Binding SelectedAdapter}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="{StaticResource ControlBackgroundBrush}">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0D47A1"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A237E"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Navn"        Binding="{Binding Name}"          Width="*"/>
                                            <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}"   Width="2*"/>
                                            <DataGridTextColumn Header="IP-adresse"  Binding="{Binding IpAddresses[0]}" Width="150"/>
                                            <DataGridTextColumn Header="MAC-adresse" Binding="{Binding MacAddress}"    Width="150"/>
                                            <DataGridTextColumn Header="IP-tilstand" Binding="{Binding DhcpText}"      Width="90"/>
                                            <DataGridTextColumn Header="Status"      Binding="{Binding Status}"        Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Reset Adapter"
                            Style="{StaticResource DarkButtonStyle}"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding ResetAdapterCommand}"/>
                </Grid>

                <!-- ===================================================== -->
                <!--  IP CONFIG PANEL                                        -->
                <!-- ===================================================== -->
                <Grid x:Name="IpConfigPanel" Visibility="Collapsed"
                      DataContext="{Binding IpConfigVm}"
                      Margin="20,12,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ADAPTER SELECTION CARD -->
                    <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                                         Background="#1C2535"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Select Network Adapter:" FontWeight="Bold"
                                       Foreground="{StaticResource DarkForegroundBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="IpConfigAdapterDropdownButton"
                                    Style="{StaticResource AdapterDropdownStyle}"
                                    Width="300" Height="30"
                                    Click="IpConfigAdapterDropdownButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedAdapterLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12" Foreground="#CCCCCC"
                                               Margin="10,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="#666666" FontSize="12"/>
                                </Grid>
                            </Button>
                            <Button Content="Refresh" Style="{StaticResource DarkButtonStyle}"
                                    Margin="10,0,0,0" Width="80"
                                    Command="{Binding RefreshAdaptersCommand}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- IP CONFIGURATION CARD -->
                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,0" Padding="16,12"
                                         Background="#1C2535"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="IP Configuration" FontWeight="Bold"
                                       Foreground="{StaticResource DarkForegroundBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RadioButton Grid.Column="0" Grid.Row="0" Content="DHCP"
                                         Foreground="{StaticResource DarkForegroundBrush}"
                                         IsChecked="{Binding IsDhcp}"
                                         Margin="0,0,20,8"/>
                            <RadioButton Grid.Column="0" Grid.Row="1" Content="Static IP"
                                         Foreground="{StaticResource DarkForegroundBrush}"
                                         IsChecked="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"
                                         Margin="0,0,20,0"/>

                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Margin="10,0,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="IP Address:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Subnet Mask:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Gateway:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource DarkForegroundBrush}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply DHCP"      Style="{StaticResource DarkButtonStyle}"
                                        Width="120" Margin="0,0,10,0" Command="{Binding ApplyDhcpCommand}"/>
                                <Button Content="Apply Static IP" Style="{StaticResource DarkButtonStyle}"
                                        Width="120" Margin="0,0,10,0" Command="{Binding ApplyStaticIpCommand}"/>
                                <Button Content="Flush DNS"       Style="{StaticResource DarkButtonStyle}"
                                        Width="120"               Command="{Binding FlushDnsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                    </Grid>

                <!-- ===================================================== -->
                <!--  WORKSPACE PANEL                                       -->
                <!-- ===================================================== -->
                <views:WorkspaceView x:Name="WorkspacePanel" Visibility="Collapsed"
                                     DataContext="{Binding WorkspaceVm}"/>

                <!-- ===================================================== -->
                <!--  TRACEROUTE PANEL                                       -->
                <!-- ===================================================== -->
                <views:TracerouteView x:Name="TraceroutePanel" Visibility="Collapsed"
                                      DataContext="{Binding TracerouteVm}"/>

                <!-- ===================================================== -->
                <!--  FIND IP PANEL                                          -->
                <!-- ===================================================== -->
                <views:FindIpView x:Name="FindIpPanel" Visibility="Collapsed"
                                  DataContext="{Binding FindIpVm}"/>

                <!-- ===================================================== -->
                <!--  MAC ALIAS PANEL                                        -->
                <!-- ===================================================== -->
                <views:MacAliasView x:Name="MacAliasPanel" Visibility="Collapsed"
                                    DataContext="{Binding MacAliasVm}"/>

            </Grid>
            <!-- end content panels -->

        </Grid>
        <!-- end content area -->

    </Grid>
    <!-- end root grid -->

</Window>
