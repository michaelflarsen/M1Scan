<Window x:Class="M1Scan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:M1Scan.Views"
        mc:Ignorable="d"
        Title="M1Scan" Height="760" Width="1400" MinWidth="1100" MinHeight="600"
        Icon="/app.ico"
        Background="{StaticResource DarkBackgroundBrush}">

    <Window.Resources>

        <!-- Sidebar nav RadioButton style -->
        <Style x:Key="SideNavStyle" TargetType="RadioButton">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="#777777"/>
            <Setter Property="BorderBrush"               Value="Transparent"/>
            <Setter Property="BorderThickness"           Value="3,0,0,0"/>
            <Setter Property="Padding"                   Value="16,11"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#1B2D44"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#1565C0"/>
                                <Setter Property="Foreground"                   Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsEnabled"   Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="#141E2C"/>
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar section header -->
        <Style x:Key="SideNavHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#444444"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="19,14,0,2"/>
        </Style>

        <!-- Stats card value -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Stats card label -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin"    Value="0,2,0,0"/>
        </Style>

        <!-- Zoom button style -->
        <Style x:Key="ZoomBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#7A9EC0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3050"/>
                                <Setter Property="Foreground" Value="#C8E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#1E2C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Adapter dropdown button (bruges nu kun af "Update now"-knappen i sidebaren) -->
        <Style x:Key="AdapterDropdownStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root: sidebar (200px) + content (*) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!--  SIDEBAR                                                      -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="#0D1117">
            <DockPanel LastChildFill="True">

                <!-- Logo / brand header -->
                <Border DockPanel.Dock="Top" Padding="0,16,0,12" Background="#07030d">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Radar icon — pure WPF geometry, 60×60 -->
                        <Viewbox Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Canvas Width="60" Height="60">

                                <!-- Pie slice fill -->
                                <Path Fill="#e0337a" Opacity="0.13">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="30,30" IsClosed="True">
                                                <LineSegment Point="43.6,9.0"/>
                                                <ArcSegment Point="51.0,16.4" Size="25,25"
                                                            SweepDirection="Clockwise" IsLargeArc="False"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Crosshair horizontal -->
                                <Line X1="5" Y1="30" X2="55" Y2="30"
                                      Stroke="#e0337a" StrokeThickness="0.5" Opacity="0.15"/>
                                <!-- Crosshair vertical -->
                                <Line X1="30" Y1="5" X2="30" Y2="55"
                                      Stroke="#e0337a" StrokeThickness="0.5" Opacity="0.15"/>

                                <!-- Outer circle r=25 -->
                                <Ellipse Canvas.Left="5"  Canvas.Top="5"  Width="50" Height="50"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.3"/>
                                <!-- Mid circle r=17 -->
                                <Ellipse Canvas.Left="13" Canvas.Top="13" Width="34" Height="34"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.5"/>
                                <!-- Inner circle r=10 -->
                                <Ellipse Canvas.Left="20" Canvas.Top="20" Width="20" Height="20"
                                         Stroke="#e0337a" StrokeThickness="1" Fill="Transparent" Opacity="0.6"/>

                                <!-- Sweep line — upper-right direction -->
                                <Line X1="30" Y1="30" X2="48" Y2="12"
                                      Stroke="#e0337a" StrokeThickness="2"/>

                                <!-- Center dot -->
                                <Ellipse Canvas.Left="27.5" Canvas.Top="27.5" Width="5" Height="5"
                                         Fill="#e0337a"/>

                                <!-- Ping dot 1 — near inner ring, upper-left -->
                                <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.95"/>
                                <!-- Ping dot 2 — near mid ring, right -->
                                <Ellipse Canvas.Left="44.5" Canvas.Top="26.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.6"/>
                                <!-- Ping dot 3 — near outer ring, lower-right -->
                                <Ellipse Canvas.Left="41.5" Canvas.Top="44.5" Width="3" Height="3"
                                         Fill="#f06ab0" Opacity="0.4"/>

                            </Canvas>
                        </Viewbox>

                        <!-- M1Scan logotype -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="M1"   FontFamily="Inter, Segoe UI, Arial" FontSize="20"
                                       FontWeight="ExtraBold" Foreground="#e0337a" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan" FontFamily="Inter, Segoe UI, Arial" FontSize="20"
                                       FontWeight="Light"     Foreground="White"    VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tagline -->
                        <TextBlock Text="NETWORK DISCOVERY"
                                   FontFamily="Inter, Segoe UI, Arial" FontSize="9"
                                   Foreground="#e0337a" Opacity="0.8"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>

                        <!-- Version -->
                        <TextBlock x:Name="AppVersionText"
                                   FontSize="9" Foreground="#444444"
                                   HorizontalAlignment="Center"/>

                        <!-- Update available badge — skjult indtil UpdateVm.IsUpdateAvailable -->
                        <Border Margin="10,8,10,0" Padding="8,6"
                                Background="#1A0E22" CornerRadius="4"
                                BorderBrush="#e0337a" BorderThickness="1"
                                Visibility="{Binding UpdateVm.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateVm.StatusText}"
                                           FontSize="10" Foreground="#f06ab0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding UpdateVm.DownloadProgressPercent, Mode=OneWay}"
                                             Foreground="#4fc3f7" Background="#0C1420" BorderThickness="0"
                                             Margin="0,0,0,5"
                                             Visibility="{Binding UpdateVm.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Content="Update now"
                                        Command="{Binding UpdateVm.UpdateNowCommand}"
                                        Style="{StaticResource AdapterDropdownStyle}"
                                        Foreground="#e0337a" FontSize="10" FontWeight="SemiBold"
                                        Padding="6,4" HorizontalContentAlignment="Center"
                                        Visibility="{Binding UpdateVm.IsDownloading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Bottom buttons: Zoom + Adapters -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">

                    <!-- Zoom widget -->
                    <Border Padding="10,7,10,5"
                            Background="#0C1420"
                            BorderBrush="#1A2A40" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="// ZOOM" FontFamily="Consolas" FontSize="9"
                                       Foreground="#3A6A9A" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Border Background="#060D18" CornerRadius="5"
                                    BorderBrush="#1A3050" BorderThickness="1"
                                    Padding="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Zoom ud -->
                                    <Button x:Name="ZoomOutBtn" Grid.Column="0"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomOut_Click" ToolTip="Zoom ud (−)">
                                        <materialDesign:PackIcon Kind="MagnifyMinus" Width="17" Height="17"
                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>

                                    <!-- Reset / procent -->
                                    <Button x:Name="ZoomResetBtn" Grid.Column="1"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomReset_Click" ToolTip="Nulstil til 100%"
                                            MinWidth="46">
                                        <TextBlock x:Name="ZoomLabel" Text="100%"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   HorizontalAlignment="Center"/>
                                    </Button>

                                    <!-- Zoom ind -->
                                    <Button x:Name="ZoomInBtn" Grid.Column="2"
                                            Style="{StaticResource ZoomBtnStyle}"
                                            Click="ZoomIn_Click" ToolTip="Zoom ind (+)">
                                        <materialDesign:PackIcon Kind="MagnifyPlus" Width="17" Height="17"
                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#151E2C" Margin="16,4"/>

                    <RadioButton x:Name="AdaptersNavBtn"
                                 Style="{StaticResource SideNavStyle}"
                                 GroupName="SideNav" Tag="Adapters" Click="SideNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanCheck" Width="18" Height="18"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Adapters" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Scrollable nav -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,6,0,0">

                        <RadioButton x:Name="HomeNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" IsChecked="True"
                                     Tag="Dashboard" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="DevicesNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Tag="Scan" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Devices" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Scan" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="WorkspaceNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Tag="DeviceFollow" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CursorDefaultClick" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Device Follow" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TracerouteNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav"
                                     Click="SideNav_Click"
                                     Tag="Traceroute">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sitemap" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Traceroute" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="IpConfigNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="IpSkift" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="IpNetworkOutline" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="IP-skift" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="FindIpNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="FindIp" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Radar" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Find IP" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="MacAliasNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="MacAlias" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="MAC Aliases" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PingMonitorNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="PingMonitor" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccessPoint" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Ping monitor" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SideNavStyle}" IsEnabled="False"
                                     GroupName="SideNav">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Fingerprint" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Fingerprints" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="HistoryNavBtn"
                                     Style="{StaticResource SideNavStyle}"
                                     GroupName="SideNav" Tag="History" Click="SideNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Historik" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  CONTENT AREA                                                 -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Stats row -->
                <RowDefinition Height="*"/>    <!-- Content panels -->
            </Grid.RowDefinitions>

            <!-- ===== STATS ROW (Devices page only) ===== -->
            <Grid Grid.Row="0" x:Name="StatsRow"
                  Background="{StaticResource DarkBackgroundBrush}"
                  Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding NetworkScanVm.DiscoveredHosts.Count}"
                                   Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Devices found" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding OnlineCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource StatValue}" Foreground="#4CAF50"/>
                        <TextBlock Text="Online" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="2" Margin="0,0,8,0" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{Binding OfflineCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource StatValue}" Foreground="#EF5350"/>
                        <TextBlock Text="Offline" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Padding="16,10"
                                     Background="#1C2535"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- NOT SCANNING: Show last scan time -->
                        <StackPanel Grid.Row="0" Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LastScanTime, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource StatValue}" FontSize="22"/>
                            <TextBlock Text="Last scanned" Style="{StaticResource StatLabel}"/>
                        </StackPanel>

                        <!-- NOT SCANNING: Show total scanning time -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                   Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="Total time: " FontSize="11" Foreground="#666"/>
                            <TextBlock Text="{Binding NetworkScanVm.ScanElapsedTime}"
                                       FontSize="11" FontFamily="Consolas" Foreground="#4a90e2" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- SCANNING: Show progress bar -->
                        <StackPanel Grid.Row="1" Orientation="Vertical"
                                   Visibility="{Binding NetworkScanVm.IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,6,0,0">
                            <!-- Header with scanning indicator -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Foreground="#4a90e2">
                                    <materialDesign:PackIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </materialDesign:PackIcon.Triggers>
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform CenterX="8" CenterY="8"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="SCANNING IN PROGRESS" FontSize="12" FontWeight="Bold"
                                          Foreground="#4a90e2" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Last scanned time during active scan -->
                            <TextBlock Text="{Binding LastScanTime, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Last Scanned: {0}'}"
                                      FontSize="10" Foreground="#666" Margin="0,0,0,6"/>


                            <!-- Progress bar (indeterminate animation) -->
                            <ProgressBar Height="4" Background="#2a3f5f" Foreground="#4a90e2" IsIndeterminate="True"/>

                            <!-- Status message -->
                            <TextBlock Text="{Binding NetworkScanVm.StatusMessage}" FontSize="11"
                                      Foreground="#aaa" Margin="0,6,0,0"/>

                            <!-- Timing info -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Elapsed: " FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="{Binding NetworkScanVm.ScanElapsedTime}"
                                              FontSize="10" FontFamily="Consolas" Foreground="#4a90e2" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text=" • " FontSize="10" Foreground="#555" Margin="4,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Est. remaining: " FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="{Binding NetworkScanVm.EstimatedTimeRemaining}"
                                              FontSize="10" FontFamily="Consolas" Foreground="#e24a4a" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- ============================================================ -->
            <!--  CONTENT PANELS                                               -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1" Background="{StaticResource DarkBackgroundBrush}">

                <!-- ===================================================== -->
                <!--  HOME PANEL                                             -->
                <!-- ===================================================== -->
                <views:HomeView x:Name="HomePanel" Visibility="Collapsed"
                                DataContext="{Binding HomeVm}"/>

                <!-- ===================================================== -->
                <!--  DEVICES PANEL (Scan)                                   -->
                <!-- ===================================================== -->
                <views:NetworkScanView x:Name="DevicesPanel" Visibility="Collapsed"
                                       DataContext="{Binding NetworkScanVm}"/>

                <!-- ===================================================== -->
                <!--  ADAPTERS PANEL                                         -->
                <!-- ===================================================== -->
                <views:AdaptersView x:Name="AdaptersPanel" Visibility="Collapsed"/>

                <!-- ===================================================== -->
                <!--  IP CONFIG PANEL                                        -->
                <!-- ===================================================== -->
                <views:IpConfigView x:Name="IpConfigPanel" Visibility="Collapsed"
                                    DataContext="{Binding IpConfigVm}"/>

                <!-- ===================================================== -->
                <!--  WORKSPACE PANEL                                       -->
                <!-- ===================================================== -->
                <views:WorkspaceView x:Name="WorkspacePanel" Visibility="Collapsed"
                                     DataContext="{Binding WorkspaceVm}"/>

                <!-- ===================================================== -->
                <!--  TRACEROUTE PANEL                                       -->
                <!-- ===================================================== -->
                <views:TracerouteView x:Name="TraceroutePanel" Visibility="Collapsed"
                                      DataContext="{Binding TracerouteVm}"/>

                <!-- ===================================================== -->
                <!--  FIND IP PANEL                                          -->
                <!-- ===================================================== -->
                <views:FindIpView x:Name="FindIpPanel" Visibility="Collapsed"
                                  DataContext="{Binding FindIpVm}"/>

                <!-- ===================================================== -->
                <!--  MAC ALIAS PANEL                                        -->
                <!-- ===================================================== -->
                <views:MacAliasView x:Name="MacAliasPanel" Visibility="Collapsed"
                                    DataContext="{Binding MacAliasVm}"/>

                <!-- ===================================================== -->
                <!--  HISTORIK PANEL                                         -->
                <!-- ===================================================== -->
                <views:HistoryView x:Name="HistoryPanel" Visibility="Collapsed"
                                   DataContext="{Binding HistoryVm}"/>

                <!-- ===================================================== -->
                <!--  PING MONITOR PANEL                                     -->
                <!-- ===================================================== -->
                <views:PingMonitorView x:Name="PingMonitorPanel" Visibility="Collapsed"
                                       DataContext="{Binding PingMonitorVm}"/>

            </Grid>
            <!-- end content panels -->

        </Grid>
        <!-- end content area -->

    </Grid>
    <!-- end root grid -->

</Window>
