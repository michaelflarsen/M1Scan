<UserControl x:Class="M1Scan.Views.AdaptersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DarkBackgroundBrush}">

    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Refresh Adapters"
                Style="{StaticResource DarkButtonStyle}"
                Margin="0,0,0,10" Width="150" HorizontalAlignment="Left"
                Command="{Binding RefreshAdaptersCommand}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#2A6034" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Aktive adaptere" FontWeight="SemiBold"
                                   Foreground="#6FCF97" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding ActiveAdapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="{StaticResource ControlBackgroundBrush}">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0D47A1"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A237E"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Navn"       Binding="{Binding Name}"           Width="*"/>
                                <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}"  Width="2*"/>
                                <DataGridTextColumn Header="IP-adresse" Binding="{Binding IpAddresses[0]}" Width="150"/>
                                <DataGridTextColumn Header="MAC-adresse" Binding="{Binding MacAddress}"   Width="150"/>
                                <DataGridTextColumn Header="IP-tilstand" Binding="{Binding DhcpText}"     Width="90"/>
                                <DataGridTextColumn Header="Status"     Binding="{Binding Status}"         Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#5C2A2A" BorderThickness="1" CornerRadius="4"
                        Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Inaktive adaptere" FontWeight="SemiBold"
                                   Foreground="#EB5757" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding InactiveAdapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="{StaticResource ControlBackgroundBrush}">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0D47A1"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A237E"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Navn"        Binding="{Binding Name}"          Width="*"/>
                                <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}"   Width="2*"/>
                                <DataGridTextColumn Header="IP-adresse"  Binding="{Binding IpAddresses[0]}" Width="150"/>
                                <DataGridTextColumn Header="MAC-adresse" Binding="{Binding MacAddress}"    Width="150"/>
                                <DataGridTextColumn Header="IP-tilstand" Binding="{Binding DhcpText}"      Width="90"/>
                                <DataGridTextColumn Header="Status"      Binding="{Binding Status}"        Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Reset Adapter"
                Style="{StaticResource DarkButtonStyle}"
                Margin="0,10,0,0" HorizontalAlignment="Left"
                Command="{Binding ResetAdapterCommand}"/>
    </Grid>
</UserControl>
