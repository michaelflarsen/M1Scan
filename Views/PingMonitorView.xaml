<UserControl x:Class="M1Scan.Views.PingMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:M1Scan.Controls"
             Background="{StaticResource DarkBackgroundBrush}">

    <Grid Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ADD TARGET CARD -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                             Background="#1C2535"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="Pulse" Width="26" Height="26"
                                             Foreground="#4a90e2" VerticalAlignment="Center"/>
                    <TextBlock Text="Ping monitor — Overvåg oppetid og latency løbende" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource DarkForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="Pinger de valgte mål med jævne mellemrum og viser svartid, jitter, pakketab og oppetid over de seneste 24 timer. Brug det til at holde øje med kritiske enheder som routeren eller en DNS-server over tid."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Mål (IP/hostname):"
                               Foreground="{StaticResource DarkForegroundBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding NewHostInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="1.1.1.1 eller router.local"/>

                    <TextBlock Grid.Column="2" Text="Beskrivelse:"
                               Foreground="{StaticResource DarkForegroundBrush}"
                               VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <TextBox Grid.Column="3" Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding NewDescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="f.eks. ISP-router"/>

                    <TextBlock Grid.Column="4" Text="Interval (s):"
                               Foreground="{StaticResource DarkForegroundBrush}"
                               VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <TextBox Grid.Column="5" Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="6" Content="Tilføj"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1565C0" BorderBrush="#1565C0"
                            Height="36" Padding="20,0" Margin="10,0,0,0"
                            Command="{Binding AddTargetCommand}"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#4a90e2" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- TARGET CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,10" Padding="16,12"
                                             Background="#1C2535"
                                             materialDesign:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource DarkForegroundBrush}"/>
                                    <TextBlock Text="{Binding HostOrIp}" FontFamily="Consolas" FontSize="12"
                                               Foreground="#64B5F6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#666666"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Fill" Value="#F44336"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Timeout">
                                                            <Setter Property="Fill" Value="#FF9800"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#888888"/>
                                        <TextBlock Text=" · " FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding LastCheckedFormatted}" FontSize="11" Foreground="#888888" FontFamily="Consolas"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Sparkline -->
                                <controls:SparklineControl Grid.Column="1" Values="{Binding Series.Values}"
                                                           Stroke="#64B5F6" Margin="16,4"
                                                           Height="46" VerticalAlignment="Center"/>

                                <!-- Stats -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#5A8AAA">
                                        <Run Text="Avg: "/><Run Text="{Binding Series.AvgDisplay, Mode=OneWay}" Foreground="#DDDDDD"/>
                                        <Run Text="  Max: "/><Run Text="{Binding Series.MaxDisplay, Mode=OneWay}" Foreground="#DDDDDD"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#5A8AAA" Margin="0,2,0,0">
                                        <Run Text="Jitter: "/><Run Text="{Binding Series.JitterDisplay, Mode=OneWay}" Foreground="#DDDDDD"/>
                                        <Run Text="  Tab: "/><Run Text="{Binding Series.LossDisplay, Mode=OneWay}" Foreground="#DDDDDD"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#5A8AAA" Margin="0,2,0,0">
                                        <Run Text="Uptime (24t): "/><Run Text="{Binding UptimeDisplay, Mode=OneWay}" Foreground="#4CAF50"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="32" Height="32" Padding="2"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="#64B5F6"
                                            ToolTip="Test forbindelse — sammenlign med internet-reference"
                                            Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16"/>
                                    </Button>
                                    <Button Width="32" Height="32" Padding="2" Margin="4,0,0,0"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="#EF5350"
                                            ToolTip="Fjern mål"
                                            Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
