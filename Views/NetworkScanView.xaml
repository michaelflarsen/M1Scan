<UserControl x:Class="M1Scan.Views.NetworkScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:M1Scan.Utils"
             Background="{StaticResource DarkBackgroundBrush}">

    <UserControl.Resources>
        <!-- Lokal kopi af sidebar-adapterknappens stil (AdapterDropdownStyle i MainWindow
             er kun synlig i Window-scope, ikke fra denne UserControl). -->
        <Style x:Key="AdapterDropdownStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,6,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Scan bar -->
            <RowDefinition Height="Auto"/> <!-- Search -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" Padding="16,12" Background="#1C2535" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Radar" Width="26" Height="26" Foreground="#4a90e2" VerticalAlignment="Center"/>
                    <TextBlock Text="Scan — Aktiv netværksscanning" FontSize="24" FontWeight="Bold" Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="Scanner aktivt et helt subnet ved at pinge hver adresse i det valgte IP-interval og opdager alle enheder der svarer. For hver host vises IP, MAC-adresse, producent (vendor), TTL/OS-gæt og åbne porte (80/443/8080), så du hurtigt får et komplet overblik over hvad der er online på netværket."/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Scan bar -->
        <Border Grid.Row="1" Background="#0D1520" CornerRadius="4" Padding="12,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DevicesAdapterDropdownButton"
                        Grid.Column="0"
                        Style="{StaticResource AdapterDropdownStyle}"
                        MinWidth="200" MaxWidth="420" Height="30"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        Click="AdapterDropdownButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedAdapterLabel}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12" Foreground="#CCCCCC"
                                   Margin="10,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="▾"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#666666" FontSize="12"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="Subnet:" VerticalAlignment="Center"
                               Foreground="#AAAAAA" FontSize="12" Margin="0,0,6,0"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="108" Height="30"
                             Text="{Binding SubnetInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="." VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                             Text="{Binding StartIp, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="–" VerticalAlignment="Center" Foreground="#888888" Margin="3,0"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Width="38" Height="30"
                             Text="{Binding EndIp, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Auto-detect" Margin="6,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="30" Padding="6,0"
                            Command="{Binding AutoDetectSubnetCommand}"/>
                    <Button Content="Clear" Margin="4,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="30" Padding="6,0"
                            Command="{Binding ClearResultsCommand}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1565C0" BorderBrush="#1565C0"
                        Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                        Command="{Binding ScanNetworkCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Scan Network" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="30" VerticalAlignment="Center"
                        Command="{Binding CancelScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Annuller" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                        ToolTip="Kør endnu en scan uden at fjerne de nuværende resultater"
                        Command="{Binding AddScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistPlus" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Tilføj scan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="6"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="30" VerticalAlignment="Center"
                        ToolTip="Eksportér enhederne i listen til CSV eller JSON"
                        Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Eksportér" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Search box -->
        <TextBox Grid.Row="2" Margin="0,0,0,6" Height="30"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Search IP, hostname, vendor…"
                 materialDesign:HintAssist.Foreground="#444444"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredHosts, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{StaticResource ControlBackgroundBrush}"
                  BorderBrush="{StaticResource ControlBorderBrush}"
                  BorderThickness="1"
                  RowHeight="28"
                  ColumnHeaderHeight="30"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  CanUserReorderColumns="False"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="4,0,4,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                              Color="#0D47A1"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                          Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"             Color="#1A237E"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"         Color="White"/>
                <utils:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
            </DataGrid.Resources>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"   Value="#151E2C"/>
                    <Setter Property="Foreground"   Value="#888888"/>
                    <Setter Property="Padding"      Value="6,0"/>
                    <Setter Property="FontSize"     Value="11"/>
                    <Setter Property="FontWeight"   Value="SemiBold"/>
                    <Setter Property="BorderBrush"  Value="{StaticResource ControlBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DarkForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <!-- Navngiv: gemmes på MAC, så navnet følger enheden
                                     når DHCP giver den en ny IP. Overstyrer mDNS/DNS/NetBIOS. -->
                                <MenuItem Header="Navngiv enhed…"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.RenameHostCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Port-historik…"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.ShowPortHistoryCommand}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="Ping denne host"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.PingHostCommand}"
                                          CommandParameter="{Binding IpAddress}"/>
                                <MenuItem Header="Kopier IP"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.CopyIpCommand}"
                                          CommandParameter="{Binding IpAddress}"/>
                                <MenuItem Header="Kopier MAC"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.CopyMacCommand}"
                                          CommandParameter="{Binding MacAddress}"/>
                                <Separator/>
                                <MenuItem Header="Åbn :80 i browser"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                          CommandParameter="{Binding Url80}"
                                          IsEnabled="{Binding IsPort80Open}"/>
                                <MenuItem Header="Åbn :443 i browser"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                          CommandParameter="{Binding Url443}"
                                          IsEnabled="{Binding IsPort443Open}"/>
                                <MenuItem Header="Åbn :8080 i browser"
                                          Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                          CommandParameter="{Binding Url8080}"
                                          IsEnabled="{Binding IsPort8080Open}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReachable}" Value="True">
                            <Setter Property="Background" Value="#121F12"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsReachable}" Value="False">
                            <Setter Property="Background" Value="#1F1212"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1D2D3D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <!-- IP address -->
                <DataGridTemplateColumn Header="IP address" SortMemberPath="IpSortValue" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12"
                                       TextTrimming="None">
                                <Hyperlink Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding IpAddress}"
                                           Foreground="#64B5F6"
                                           TextDecorations="None">
                                    <Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Hostname — stretches with window.
                     DisplayName falder tilbage til NetBIOS-navnet når
                     reverse-DNS ikke gav noget (se HostInfo.DisplayName). -->
                <DataGridTextColumn Header="Hostname" Binding="{Binding DisplayName}" Width="2*" MinWidth="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"     Value="{StaticResource DarkForegroundBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming"   Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Enhedstype — bedste-gæt ud fra TTL/vendor/porte/navn (se Utils/DeviceFingerprint.cs) -->
                <DataGridTemplateColumn Header="Type" Width="40" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="{Binding CategoryIcon}" Width="18" Height="18"
                                                     Foreground="#5A8AAA" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding CategoryLabel}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Ændring i portopsætning — kun synlig når mindst én overvåget port
                     skiftede i det senest afsluttede scan (se HostInfo.SetPortChangeFlags).
                     Forbliver synlig indtil næste scan genberegner flagene. -->
                <DataGridTemplateColumn Header="!" Width="30" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16"
                                                     Foreground="#FFB300" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding PortChangeSummary}"
                                                     Visibility="{Binding HasPortChange, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- MAC address -->
                <DataGridTextColumn Header="MAC address" Binding="{Binding MacAddress}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"     Value="#888888"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontFamily"     Value="Consolas"/>
                            <Setter Property="FontSize"       Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Vendor -->
                <DataGridTemplateColumn Header="Vendor" Width="210" SortMemberPath="Vendor">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="vnd" Text="{Binding Vendor}"
                                       Foreground="{StaticResource DarkForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OriginalVendor}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Vendor}" Value="">
                                    <Setter TargetName="vnd" Property="Text"       Value="—"/>
                                    <Setter TargetName="vnd" Property="Foreground" Value="#3A3A3A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAlias}" Value="True">
                                    <Setter TargetName="vnd" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- :80 chip -->
                <DataGridTemplateColumn Header=":80" Width="40" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="40" HorizontalAlignment="Center"
                                    Padding="3,2"
                                    FontFamily="Consolas" FontSize="11"
                                    FocusVisualStyle="{x:Null}"
                                    Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                    CommandParameter="{Binding Url80}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="#444444"/>
                                        <Setter Property="Cursor"     Value="Arrow"/>
                                        <Setter Property="IsEnabled"  Value="False"/>
                                        <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush"     Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="txt" Text=":80"
                                                                   FontFamily="{TemplateBinding FontFamily}"
                                                                   FontSize="{TemplateBinding FontSize}"
                                                                   FontWeight="{TemplateBinding FontWeight}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsEnabled"   Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd"  Property="Background" Value="#0A303A"/>
                                                            <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPort80Open}" Value="True">
                                                <Setter Property="IsEnabled"  Value="True"/>
                                                <Setter Property="Cursor"     Value="Hand"/>
                                                <Setter Property="Background" Value="#0A2028"/>
                                                <Setter Property="Foreground" Value="#00BCD4"/>
                                                <Setter Property="ToolTip"    Value="Åbn i browser (http)"/>
                                            </DataTrigger>
                                            <!-- Skiftede i sidste scan — glødende ring, uanset om porten nu er
                                                 åben eller lukket, så en netop-lukket port også fremhæves. -->
                                            <DataTrigger Binding="{Binding Port80Changed}" Value="True">
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush"     Value="#FFB300"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- :443 chip -->
                <DataGridTemplateColumn Header=":443" Width="48" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="40" HorizontalAlignment="Center"
                                    Padding="3,2"
                                    FontFamily="Consolas" FontSize="11"
                                    FocusVisualStyle="{x:Null}"
                                    Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                    CommandParameter="{Binding Url443}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="#444444"/>
                                        <Setter Property="Cursor"     Value="Arrow"/>
                                        <Setter Property="IsEnabled"  Value="False"/>
                                        <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush"     Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="txt" Text=":443"
                                                                   FontFamily="{TemplateBinding FontFamily}"
                                                                   FontSize="{TemplateBinding FontSize}"
                                                                   FontWeight="{TemplateBinding FontWeight}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsEnabled"   Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd"  Property="Background" Value="#221040"/>
                                                            <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPort443Open}" Value="True">
                                                <Setter Property="IsEnabled"  Value="True"/>
                                                <Setter Property="Cursor"     Value="Hand"/>
                                                <Setter Property="Background" Value="#1A0C30"/>
                                                <Setter Property="Foreground" Value="#CE93D8"/>
                                                <Setter Property="ToolTip"    Value="Åbn i browser (https)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Port443Changed}" Value="True">
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush"     Value="#FFB300"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- :8080 chip -->
                <DataGridTemplateColumn Header=":8080" Width="54" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="46" HorizontalAlignment="Center"
                                    Padding="3,2"
                                    FontFamily="Consolas" FontSize="11"
                                    FocusVisualStyle="{x:Null}"
                                    Command="{Binding Source={StaticResource VmProxy}, Path=Data.OpenInBrowserCommand}"
                                    CommandParameter="{Binding Url8080}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="#444444"/>
                                        <Setter Property="Cursor"     Value="Arrow"/>
                                        <Setter Property="IsEnabled"  Value="False"/>
                                        <Setter Property="ToolTip"    Value="Port ikke åben"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush"     Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock x:Name="txt" Text=":8080"
                                                                   FontFamily="{TemplateBinding FontFamily}"
                                                                   FontSize="{TemplateBinding FontSize}"
                                                                   FontWeight="{TemplateBinding FontWeight}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsEnabled"   Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd"  Property="Background" Value="#341222"/>
                                                            <Setter TargetName="txt" Property="FontWeight"  Value="SemiBold"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPort8080Open}" Value="True">
                                                <Setter Property="IsEnabled"  Value="True"/>
                                                <Setter Property="Cursor"     Value="Hand"/>
                                                <Setter Property="Background" Value="#280E1A"/>
                                                <Setter Property="Foreground" Value="#F06292"/>
                                                <Setter Property="ToolTip"    Value="Åbn i browser (port 8080)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Port8080Changed}" Value="True">
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush"     Value="#FFB300"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Other ports (badge) -->
                <DataGridTemplateColumn Header="Other" Width="65" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="OtherBd" Background="#261A38" CornerRadius="10" Padding="7,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="502"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#CE93D8"
                                           VerticalAlignment="Center"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPort502Open}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- Netop lukket: forbliver synlig med glødende ring, så
                                                 lukningen ses, selvom porten ikke længere er åben. -->
                                            <DataTrigger Binding="{Binding Port502Changed}" Value="True">
                                                <Setter Property="Visibility"      Value="Visible"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush"     Value="#FFB300"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Ping ms -->
                <DataGridTextColumn Header="ms" Binding="{Binding ResponseTime}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"          Value="#666666"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding"             Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
