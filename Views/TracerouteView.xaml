<UserControl x:Class="M1Scan.Views.TracerouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DarkBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,12,20,10">
            <!-- HEADER CARD -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16,12"
                                 Background="#1C2535"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Sitemap" Width="26" Height="26"
                                                 Foreground="#4a90e2" VerticalAlignment="Center"/>
                        <TextBlock Text="Traceroute — Spor netværksrute til en vært" FontSize="24" FontWeight="Bold"
                                   Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"
                               Text="Visualiserer det netværksrute (hops) som dine pakker tager fra din computer til en destination. For hver hop vises latency (forsinkelse), og du kan se hvor længe de enkelte routere tager at svare. Perfekt til at diagnosticere netværksforsinkelser og finde problematiske forbindelser."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Værtsnavn eller IP:" Foreground="#b0b0b0" VerticalAlignment="Center" Width="150"/>
                <TextBox Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2a3f5f" Foreground="#e0e0e0" Padding="10,8" Width="300"
                         IsEnabled="{Binding CanEditTarget}"/>
                <Button Command="{Binding TraceCommand}" Content="Spor rute"
                        Background="#4a90e2" Foreground="White" Padding="15,8" Margin="10,0,0,0"/>
                <Button Command="{Binding ProbeLoopCommand}" Foreground="White" Padding="15,8" Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="#9c27b0"/>
                            <Setter Property="Content" Value="Start løbende probe"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTraceComplete}" Value="True"/>
                                        <Condition Binding="{Binding IsProbing}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#ff9800"/>
                                    <Setter Property="Content" Value="⏸ Stoppe probe"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding CancelTraceCommand}" Content="Annuller"
                        Background="#e74c3c" Foreground="White" Padding="15,8" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Geo-opslag er som standard slået FRA: det sender rutens offentlige
                 IP'er til ip-api.com over ukrypteret HTTP. Brugeren skal selv vælge det. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding GeoLookupEnabled}"
                          Content="Slå land/ASN-opslag til"
                          Foreground="#cfd8dc" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GeoLookupHint}"
                           Foreground="#78909c" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#90caf9" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="✓ FULDFØRT" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTraceComplete}" Value="True"/>
                                        <Condition Binding="{Binding IsProbing}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </StackPanel>

                    <ProgressBar Height="5" Value="{Binding TraceProgress}" Maximum="100"
                                 Background="#2a3f5f" Foreground="#4a90e2" Margin="0,12,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Hop-graf CARD -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16,12"
                                 Background="#1C2535"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Latency pr. hop" Foreground="#e0337a" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Canvas x:Name="HopGraphCanvas" Height="250" Background="#0d0812"
                            Margin="0,0,0,0" SizeChanged="HopGraphCanvas_SizeChanged"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- DETALJE-TABEL CARD -->
            <materialDesign:Card Margin="0,0,0,0" Padding="0"
                                 Background="#1C2535"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <DataGrid ItemsSource="{Binding Hops}" Background="#141c28" Foreground="#e0e0e0"
                          HeadersVisibility="Column" AutoGenerateColumns="False" ColumnWidth="*" BorderThickness="0"
                          PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#1a2332"/>
                        <Setter Property="Foreground" Value="#e0e0e0"/>
                        <Style.Triggers>
                            <!-- Hover effect — synlig når musen er over raden -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d3d4d"/>
                            </Trigger>
                            <!-- Selected effect — synlig når raden er valgt -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="50"/>
                    <DataGridTextColumn Header="IP-adresse" Binding="{Binding IpAddress}" Width="150"/>
                    <DataGridTextColumn Header="Værtsnavn" Binding="{Binding HostName}" Width="200"/>
                    <DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="120"/>
                    <DataGridTextColumn Header="ASN" Binding="{Binding Asn}" Width="220"/>
                    <DataGridTextColumn Header="Avg. Latency (ms)" Binding="{Binding LatencySeries.AvgDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Jitter (ms)" Binding="{Binding LatencySeries.JitterDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Tab %" Binding="{Binding LatencySeries.LossDisplay}" Width="80"/>
                </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- TIDLIGERE MÅLINGER CARD -->
            <materialDesign:Card Margin="0,12,0,0" Padding="16,12"
                                 Background="#1C2535"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Tidligere målinger for dette mål" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource DarkForegroundBrush}"/>
                            <TextBlock Text="Seneste 24 timer, fra løbende probe-sessioner"
                                       Foreground="#666666" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                        <Button Content="Opdatér" Style="{StaticResource DarkButtonStyle}"
                                Width="90" HorizontalAlignment="Right"
                                Command="{Binding LoadHistoryCommand}"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding HistoricalSamples}" Background="#141c28" Foreground="#e0e0e0"
                              HeadersVisibility="Column" AutoGenerateColumns="False" ColumnWidth="*" BorderThickness="0"
                              MaxHeight="300" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#1a2332"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2d3d4d"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tidspunkt" Binding="{Binding Timestamp, StringFormat='dd/MM HH:mm:ss', ConverterCulture=da-DK}" Width="140"/>
                            <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="60"/>
                            <DataGridTextColumn Header="IP-adresse" Binding="{Binding IpAddress}" Width="150"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat='{}{0:F0} ms', TargetNullValue='Tabt'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
