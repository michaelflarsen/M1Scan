<Window x:Class="M1Scan.Views.ConnectionTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test forbindelse"
        Height="270" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E">

    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="Test forbindelse" Foreground="White" FontSize="18" FontWeight="SemiBold"/>

            <TextBlock x:Name="DescriptionText" Foreground="#90A4AE" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Pinger målet og en fast internet-reference (1.1.1.1) samtidig, så du kan se om udsving skyldes din egen forbindelse eller enheden/internettet efter den."/>

            <TextBlock Text="Varighed (sekunder)" Foreground="#CFD8DC" FontSize="12" Margin="0,18,0,6"/>
            <TextBox x:Name="DurationBox"
                     Background="#2D2D2D" Foreground="White" BorderBrush="#455A64"
                     BorderThickness="1" Padding="8,7" FontSize="14"
                     CaretBrush="White" Text="30"
                     KeyDown="DurationBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" Foreground="#EF5350" FontSize="11" Margin="0,6,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Annuller" Click="Cancel_Click"
                        Background="#37474F" Foreground="White" BorderThickness="0"
                        Padding="18,8" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Start test" Click="Start_Click"
                        Background="#4A90E2" Foreground="White" BorderThickness="0"
                        Padding="24,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
