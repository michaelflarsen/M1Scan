<UserControl x:Class="M1Scan.Views.IpConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DarkBackgroundBrush}">

    <UserControl.Resources>
        <!-- Lokal kopi af sidebar-adapterknappens stil (AdapterDropdownStyle i MainWindow
             er kun synlig i Window-scope, ikke fra denne UserControl). -->
        <Style x:Key="AdapterDropdownStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,6,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Adapter selection -->
            <RowDefinition Height="*"/>    <!-- IP configuration -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="16,12" Background="#1C2535" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="IpNetworkOutline" Width="26" Height="26" Foreground="#4a90e2" VerticalAlignment="Center"/>
                    <TextBlock Text="IP-skift — Skift mellem DHCP og statisk IP" FontSize="24" FontWeight="Bold" Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="Ændrer IP-konfigurationen på en valgt netværksadapter. Skift hurtigt til DHCP så adapteren automatisk får en adresse fra routeren, eller sæt en statisk IP med subnetmaske, gateway og DNS efter behov. Ændringerne udføres via netsh og kræver administratorrettigheder. Her kan du også rydde (flushe) DNS-cachen."/>
            </StackPanel>
        </materialDesign:Card>

        <!-- ADAPTER SELECTION CARD -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" Padding="16,12"
                             Background="#1C2535"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <TextBlock Text="Select Network Adapter:" FontWeight="Bold"
                           Foreground="{StaticResource DarkForegroundBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="IpConfigAdapterDropdownButton"
                        Style="{StaticResource AdapterDropdownStyle}"
                        Width="300" Height="30"
                        Click="IpConfigAdapterDropdownButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedAdapterLabel}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12" Foreground="#CCCCCC"
                                   Margin="10,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="▾"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#666666" FontSize="12"/>
                    </Grid>
                </Button>
                <Button Content="Refresh" Style="{StaticResource DarkButtonStyle}"
                        Margin="10,0,0,0" Width="80"
                        Command="{Binding RefreshAdaptersCommand}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- IP CONFIGURATION CARD -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,0" Padding="16,12"
                             Background="#1C2535"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="IP Configuration" FontWeight="Bold"
                           Foreground="{StaticResource DarkForegroundBrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Column="0" Grid.Row="0" Content="DHCP"
                                 Foreground="{StaticResource DarkForegroundBrush}"
                                 IsChecked="{Binding IsDhcp}"
                                 Margin="0,0,20,8"/>
                    <RadioButton Grid.Column="0" Grid.Row="1" Content="Static IP"
                                 Foreground="{StaticResource DarkForegroundBrush}"
                                 IsChecked="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,0,20,0"/>

                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Margin="10,0,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="IP Address:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Subnet Mask:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Gateway:" Foreground="{StaticResource DarkForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsDhcp, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource DarkForegroundBrush}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply DHCP"      Style="{StaticResource DarkButtonStyle}"
                            Width="120" Margin="0,0,10,0" Command="{Binding ApplyDhcpCommand}"/>
                    <Button Content="Apply Static IP" Style="{StaticResource DarkButtonStyle}"
                            Width="120" Margin="0,0,10,0" Command="{Binding ApplyStaticIpCommand}"/>
                    <Button Content="Flush DNS"       Style="{StaticResource DarkButtonStyle}"
                            Width="120"               Command="{Binding FlushDnsCommand}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
