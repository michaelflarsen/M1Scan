<Window x:Class="M1Scan.Views.ConnectionTestReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:M1Scan.Controls"
        Title="Forbindelsesrapport"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackgroundBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="Forbindelsesrapport"
                   Foreground="White" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="SubtitleText"
                   Foreground="#8fa3bf" FontSize="12" Margin="0,4,0,0"/>

        <!-- Verdict -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10" CornerRadius="4" Background="#1C2535">
            <TextBlock x:Name="VerdictText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Reference series (1.1.1.1) -->
        <materialDesign:Card Grid.Row="3" Margin="0,14,0,0" Padding="14,10" Background="#1C2535">
            <StackPanel>
                <TextBlock Text="Internet-reference · 1.1.1.1" Foreground="#64B5F6" FontSize="12" FontWeight="Bold"/>
                <controls:SparklineControl x:Name="ReferenceSparkline" Height="46" Margin="0,8" Stroke="#64B5F6"/>
                <TextBlock x:Name="ReferenceStatsText" FontFamily="Consolas" FontSize="11" Foreground="#DDDDDD"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Target series -->
        <materialDesign:Card Grid.Row="4" Margin="0,12,0,0" Padding="14,10" Background="#1C2535">
            <StackPanel>
                <TextBlock x:Name="TargetSeriesLabel" Text="Mål" Foreground="#FFB74D" FontSize="12" FontWeight="Bold"/>
                <controls:SparklineControl x:Name="TargetSparkline" Height="46" Margin="0,8" Stroke="#FFB74D"/>
                <TextBlock x:Name="TargetStatsText" FontFamily="Consolas" FontSize="11" Foreground="#DDDDDD"/>
            </StackPanel>
        </materialDesign:Card>

        <TextBlock Grid.Row="5" Foreground="#5A8AAA" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Lav latency/jitter/tab på begge linjer, men problemer kun på målet, peger på enheden eller dens egen forbindelse. Problemer på begge linjer samtidig peger på din egen internetforbindelse."/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Gem rapport..." Click="Save_Click"
                    Background="#37474F" Foreground="White" BorderThickness="0"
                    Padding="18,8" Margin="0,0,10,0"/>
            <Button Content="Luk" Click="Close_Click"
                    Background="#4A90E2" Foreground="White" BorderThickness="0"
                    Padding="24,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
