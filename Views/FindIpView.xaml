<UserControl x:Class="M1Scan.Views.FindIpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DarkBackgroundBrush}">
    <UserControl.Resources>
        <!-- Lokal kopi af sidebar-adapterknappens stil (AdapterDropdownStyle i MainWindow
             er kun synlig i Window-scope, ikke fra denne UserControl). -->
        <Style x:Key="AdapterDropdownStyle" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#2A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#263A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER CARD -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                             Background="#1C2535"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <!-- Titel + forklaring -->
                <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Radar" Width="26" Height="26"
                                             Foreground="#4a90e2" VerticalAlignment="Center"/>
                    <TextBlock Text="Find IP — passiv segment-sniffer" FontSize="24" FontWeight="Bold"
                               Foreground="#e0e0e0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#8fa3bf" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Lytter passivt på det fysiske netværkssegment (samme switch) og opdager enheder ud fra deres broadcast/multicast &quot;wakeup calls&quot; — DHCP, mDNS, SSDP, NetBIOS m.fl. Enheder med en IP uden for dit eget subnet fremhæves, så du kan fange en ukendt enhed der f.eks. sidder på 172.10.1.5 mens du selv er på 192.168.1.x."/>

                <!-- Kontroller -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
            <TextBlock Text="Adapter:" Foreground="#b0b0b0" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="FindIpAdapterDropdownButton"
                    Style="{StaticResource AdapterDropdownStyle}"
                    MinWidth="220" MaxWidth="380" Height="32"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    Click="FindIpAdapterDropdownButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SelectedAdapterLabel}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="12" Foreground="#CCCCCC" Margin="10,0,4,0"/>
                    <TextBlock Grid.Column="1" Text="▾" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="#666666" FontSize="12"/>
                </Grid>
            </Button>

            <Button Command="{Binding StartCommand}" Content="▶ Start lytning"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Command="{Binding StopCommand}" Content="⏹ Stop"
                    Background="#e74c3c" Foreground="White" BorderThickness="0"
                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Command="{Binding ClearCommand}" Content="Ryd"
                    Background="#2a3f5f" Foreground="#e0e0e0" BorderThickness="0"
                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>

            <CheckBox IsChecked="{Binding OnlyForeignOnSegment}" VerticalAlignment="Center"
                      Margin="12,0,0,0" Foreground="#e0e0e0" Content="Kun fremmede på mit segment"/>
        </StackPanel>

                <!-- Status -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#90caf9" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Foreground="#8fa3bf" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="{Binding TotalPackets, StringFormat='Pakker: {0}'}"/>
                </StackPanel>

                <!-- Kolonneoverskrift-hint -->
                <TextBlock Foreground="#5f7392" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Orange = fremmed enhed bekræftet på dit eget segment (det du leder efter: IP uden for dit subnet, men på samme switch). Violet = ISP'ens CGNAT-lag (100.64.0.0/10, RFC 6598) — infrastruktur mellem dig og internettet, ikke en enhed på dit LAN. Øvrige rækker uden for subnet er typisk WAN-endepunkter din trafik går til."/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Enhedsliste CARD -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,0" Padding="0"
                             Background="#1C2535"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             MaxHeight="600">
                <DataGrid
                      ItemsSource="{Binding DevicesView}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="#141c28"
                      Foreground="#e0e0e0" BorderBrush="#2a3f5f" BorderThickness="0"
                      HorizontalGridLinesBrush="#243347"
                      CanUserResizeRows="False" CanUserAddRows="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#1c2636"/>
                    <Setter Property="Foreground" Value="#e0e0e0"/>
                    <Style.Triggers>
                        <!-- Lokalt subnet — standard farve (lidt lysere blå) -->
                        <DataTrigger Binding="{Binding IsOutsideSubnet}" Value="False">
                            <Setter Property="Background" Value="#1c2d3d"/>
                        </DataTrigger>
                        <!-- WAN-endepunkt (uden for subnet, men ikke på segment, og ikke CGNAT) — mørkegrøn tone -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOutsideSubnet}" Value="True"/>
                                <Condition Binding="{Binding IsForeignOnSegment}" Value="False"/>
                                <Condition Binding="{Binding IsCarrierNat}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#1a3a2a"/>
                            <Setter Property="Foreground" Value="#a8d5ba"/>
                        </MultiDataTrigger>
                        <!-- CGNAT (ISP-lag) — dæmpet violet så det tydeligt ikke er et fund. -->
                        <DataTrigger Binding="{Binding IsCarrierNat}" Value="True">
                            <Setter Property="Background" Value="#2a1e3a"/>
                            <Setter Property="Foreground" Value="#b39ddb"/>
                        </DataTrigger>
                        <!-- Fremmed enhed bekræftet på vores eget segment = det vigtige fund. -->
                        <DataTrigger Binding="{Binding IsForeignOnSegment}" Value="True">
                            <Setter Property="Background" Value="#3a2a12"/>
                        </DataTrigger>
                        <!-- Hover effect — synlig når musen er over raden -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2d3d4d"/>
                        </Trigger>
                        <!-- Selected effect — synlig når raden er valgt -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="LanConnect"/>
                                        <Setter Property="Foreground" Value="#4a90e2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCarrierNat}" Value="True">
                                                <Setter Property="Kind" Value="ServerNetwork"/>
                                                <Setter Property="Foreground" Value="#b39ddb"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsForeignOnSegment}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                <Setter Property="Foreground" Value="#ff9800"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="IP-adresse" Binding="{Binding IpAddress}" Width="140"
                                    SortMemberPath="IpSortValue" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150"/>
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="180"/>
                <DataGridTextColumn Header="Protokol" Binding="{Binding LastProtocol}" Width="90"/>
                <DataGridTextColumn Header="Pakker" Binding="{Binding PacketCount}" Width="70"/>
                <DataGridTextColumn Header="Først set" Binding="{Binding FirstSeenFormatted}" Width="90"/>
                <DataGridTextColumn Header="Sidst set" Binding="{Binding LastSeenFormatted}" Width="90"/>
                <DataGridTextColumn Header="Bemærkning" Binding="{Binding Note}" Width="*" MinWidth="200"/>
            </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Fodnote -->
        <TextBlock Grid.Row="2" Foreground="#5f7392" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Bemærk: uden en dedikeret pakke-driver (Npcap) begrænser switchen synlig unicast-trafik, så listen fanger primært broadcast/multicast. MAC/vendor resolves via ARP og virker på tværs af subnets på samme fysiske segment."/>
    </Grid>
</UserControl>
