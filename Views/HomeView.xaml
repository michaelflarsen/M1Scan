<UserControl x:Class="M1Scan.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:M1Scan.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <Grid x:Name="RootGrid" Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Overskrift -->
            <RowDefinition Height="12"/>    <!-- 1: Spacer -->
            <RowDefinition Height="Auto"/>  <!-- 2: Niveau 1 — Status + Topologi -->
            <RowDefinition Height="12"/>    <!-- 3: Spacer -->
            <RowDefinition Height="180" MinHeight="120"/>  <!-- 4: Niveau 2 — Gateway + Internet (resizable højde) -->
            <RowDefinition Height="6"/>     <!-- 5: GridSplitter (vertikal resize) -->
            <RowDefinition Height="Auto"/>  <!-- 6: Niveau 3 — Detaljer + Hastighed (samlet expander) -->
            <RowDefinition Height="6"/>     <!-- 7: Spacer -->
            <RowDefinition Height="Auto"/>  <!-- 8: Niveau 3 — Kendte enheder-expander -->
            <RowDefinition Height="12"/>    <!-- 9: Spacer -->
            <RowDefinition Height="Auto"/>  <!-- 10: "Diagnosticér nu" -->
            <RowDefinition Height="*"/>     <!-- 11: Scroll-spacer -->
        </Grid.RowDefinitions>

        <!-- OVERSKRIFT -->
        <TextBlock Grid.Row="0" Text="Netværksoverblik" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,0"/>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- NIVEAU 1: STATUS + TOPOLOGI (HERO)                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>  <!-- Score-kort (større) -->
                <ColumnDefinition Width="*"/>    <!-- Topologi-kæde (flexed) -->
            </Grid.ColumnDefinitions>

            <!-- NETVÆRKSSCORE-KORT -->
            <Border Grid.Column="0" Height="168" Background="#080f14"
                    BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6"
                    VerticalAlignment="Center"
                    ToolTipService.ShowDuration="30000" Cursor="Help">
                <Border.ToolTip>
                    <ToolTip Background="#060E18" BorderBrush="#1A3A5A" BorderThickness="1" Padding="18,14">
                        <StackPanel Width="460">
                            <TextBlock Text="NETVÆRKSSCORE  0 – 100" FontFamily="Consolas" FontSize="13"
                                       FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>

                            <!-- Faktorer -->
                            <TextBlock Text="Beregnes ud fra 5 faktorer:" FontSize="12"
                                       Foreground="#5A8AAA" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/><RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <!-- Row 0 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pakketab (WAN)"   FontFamily="Consolas" FontSize="12" Foreground="#64B5F6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="max 30 pt" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A" HorizontalAlignment="Right" Margin="14,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="0%→30  1%→24  &gt;5%→0" FontFamily="Consolas" FontSize="11" Foreground="#6AACBA"/>
                                <!-- Row 1 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Latency, gns ping"   FontFamily="Consolas" FontSize="12" Foreground="#64B5F6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="max 25 pt" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A" HorizontalAlignment="Right" Margin="14,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="≤20ms→25  ≤60→15  ≤150→0" FontFamily="Consolas" FontSize="11" Foreground="#6AACBA"/>
                                <!-- Row 2 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Jitter"   FontFamily="Consolas" FontSize="12" Foreground="#64B5F6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="max 20 pt" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A" HorizontalAlignment="Right" Margin="14,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="≤2ms→20  ≤10→10  ≤30→0" FontFamily="Consolas" FontSize="11" Foreground="#6AACBA"/>
                                <!-- Row 3 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="DNS-svartid"   FontFamily="Consolas" FontSize="12" Foreground="#64B5F6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="max 15 pt" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A" HorizontalAlignment="Right" Margin="14,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="≤20ms→15  ≤100→5  ≤250→0" FontFamily="Consolas" FontSize="11" Foreground="#6AACBA"/>
                                <!-- Row 4 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Gateway-stabilitet"   FontFamily="Consolas" FontSize="12" Foreground="#64B5F6"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="max 10 pt" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A" HorizontalAlignment="Right" Margin="14,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="0% tab ≤5ms→10  ≤20ms→7" FontFamily="Consolas" FontSize="11" Foreground="#6AACBA"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#1A3A5A" Margin="0,0,0,10"/>

                            <!-- Karakterer -->
                            <TextBlock Text="KARAKTERER" FontFamily="Consolas" FontSize="12"
                                       FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/>
                                    <RowDefinition Height="20"/><RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="A" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="90 – 100" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Fremragende — klar til gaming og videomøder" FontSize="12" Foreground="#9ACAAA"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="B" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#8BC34A"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="75 – 89" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="God — fin til streaming og hjemmearbejde" FontSize="12" Foreground="#9ACAAA"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="C" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="60 – 74" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Acceptabel — mindre udsving kan mærkes" FontSize="12" Foreground="#9ACAAA"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="D" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF5722"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="40 – 59" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Dårlig — forvent hak i video og spil" FontSize="12" Foreground="#9ACAAA"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="F" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="0 – 39" FontFamily="Consolas" FontSize="12" Foreground="#6AAA8A"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Kritisk — forbindelsen er ustabil" FontSize="12" Foreground="#9ACAAA"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#1A3A5A" Margin="0,10,0,10"/>

                            <TextBlock FontSize="12" Foreground="#6AAA8A" TextWrapping="Wrap">
                                <Run Text="Kan man opnå 100? " Foreground="#5A8AAA"/>
                                <Run Text="Ja — kræver ping ≤20ms, jitter ≤2ms, 0% tab, DNS ≤20ms og gateway ≤5ms med 0% tab."/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#6AAA8A" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Run Text="Kan man opnå Å? " Foreground="#5A8AAA"/>
                                <Run Text="Nej — skalaen stopper ved F (0-39). Å er ikke en karakter, men ved 0 vises »Offline«."/>
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <!-- Refresh button top-right (overlay, tager ikke layout-plads) -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Panel.ZIndex="1"
                            Background="Transparent" BorderThickness="0" Padding="3"
                            Cursor="Hand" Command="{Binding ResetScoreCommand}"
                            ToolTip="Nulstil målinger" Margin="0,4,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1A2A3A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" Foreground="#3A5A6A"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12,8">
                    <!-- Top row: Score circle + Verdict -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Score-cirkel -->
                        <Border Grid.Column="0" Width="76" Height="76" CornerRadius="38"
                                BorderThickness="2.5" BorderBrush="{Binding Health.ColorHex}"
                                Background="#0A1420" Margin="0,0,12,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                           Foreground="{Binding Health.ColorHex}" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Health.Score}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Health.IsValid}" Value="False">
                                                    <Setter Property="Text" Value="…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Health.Grade}" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding Health.ColorHex}" HorizontalAlignment="Center"
                                           Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Info text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="// NETVÆRKSSCORE" FontFamily="Consolas" FontSize="10"
                                       Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding Health.Verdict}" FontSize="11" Foreground="White"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock FontSize="9" Foreground="#3A5A6A">
                                <Run Text="Tab: "/><Run Text="{Binding WanSeries.LossPercent, Mode=OneWay, StringFormat=F0}" Foreground="#5A8AAA"/>
                                <Run Text="% · Jitter: "/><Run Text="{Binding WanSeries.JitterMs, Mode=OneWay, StringFormat=F1}" Foreground="#5A8AAA"/>
                                <Run Text="ms"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <!-- Metrics row -->
                    <Border Background="#0A1420" CornerRadius="3" Padding="8,4">
                        <StackPanel>
                            <TextBlock FontSize="9" Foreground="#3A5A6A">
                                <Run Text="Ping avg: "/><Run Text="{Binding WanSeries.AvgDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                                <Run Text=" · Max: "/><Run Text="{Binding WanSeries.MaxDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>

            <!-- TOPOLOGI-KÆDE: Adapter → Router → WAN -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Left">

                <!-- NODE 1: ADAPTER -->
                <Border Width="240" Height="168" Background="#080f14"
                        BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6" Padding="6">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Canvas Width="32" Height="32">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="28" Height="19"
                                           Stroke="#4CAF50" StrokeThickness="1" Fill="Transparent"/>
                                <Rectangle Canvas.Left="5" Canvas.Top="5" Width="22" Height="13"
                                           Fill="#071207"/>
                                <Rectangle Canvas.Left="10"   Canvas.Top="14" Width="3" Height="3" Fill="#4CAF50" Opacity="0.4"/>
                                <Rectangle Canvas.Left="14.5" Canvas.Top="12" Width="3" Height="5" Fill="#4CAF50" Opacity="0.65"/>
                                <Rectangle Canvas.Left="19"   Canvas.Top="10" Width="3" Height="7" Fill="#4CAF50" Opacity="0.9"/>
                                <Line X1="16" Y1="21" X2="16" Y2="26" Stroke="#4CAF50" StrokeThickness="1.5"/>
                                <Line X1="9" Y1="26" X2="23" Y2="26" Stroke="#4CAF50" StrokeThickness="1.5"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding DefaultAdapter.Name, FallbackValue='ADAPTER'}"
                                   FontSize="9" FontWeight="Bold" Foreground="#4CAF50"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding DefaultAdapter.IpAddress, FallbackValue='—'}"
                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DefaultAdapter.SubnetMask, FallbackValue='—'}"
                                   FontFamily="Consolas" FontSize="9" Foreground="#5A8A6A"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding DefaultAdapter.SpeedText, FallbackValue='—'}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding DefaultAdapter.Description, FallbackValue='—'}"
                                   FontSize="8" Foreground="#6A9A7A"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CHEVRON 1 (Adapter → Router) -->
                <Canvas Width="28" Height="16" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Visibility="{Binding HasGateway, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="6,0">
                    <Line X1="2" Y1="8" X2="24" Y2="8" Stroke="#4fc3f7" StrokeThickness="2"/>
                    <Polygon Points="24,2 28,8 24,14" Fill="#4fc3f7"/>
                </Canvas>

                <!-- NODE 2: ROUTER (skjult hvis ingen gateway) -->
                <Border Width="240" Height="168" Background="#080f14"
                        BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6" Padding="6"
                        Visibility="{Binding HasGateway, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Canvas Width="32" Height="32">
                                <Rectangle Canvas.Left="3" Canvas.Top="14" Width="26" Height="11"
                                           Stroke="#4fc3f7" StrokeThickness="1" Fill="Transparent"/>
                                <Line X1="9"  Y1="14" X2="8"  Y2="4" Stroke="#4fc3f7" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="6"  Canvas.Top="2" Width="4" Height="4"
                                         Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                                <Line X1="16" Y1="14" X2="16" Y2="2" Stroke="#4fc3f7" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="14" Canvas.Top="0" Width="4" Height="4"
                                         Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                                <Line X1="23" Y1="14" X2="24" Y2="4" Stroke="#4fc3f7" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="22" Canvas.Top="2" Width="4" Height="4"
                                         Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                                <Ellipse Canvas.Left="6"  Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.7"/>
                                <Ellipse Canvas.Left="14" Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.4"/>
                                <Ellipse Canvas.Left="22" Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="ROUTER" FontSize="9" FontWeight="Bold"
                                   Foreground="#4fc3f7" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding GatewayCheck.Host, FallbackValue='—'}"
                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GatewayCheck.LatencyDisplay, FallbackValue='—'}"
                                   FontSize="9" HorizontalAlignment="Center" Foreground="#2E7D32" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding RouterVendor}" FontSize="8" Foreground="#6A9AAA"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" Margin="0,2,0,0"
                                   Visibility="{Binding HasRouterVendor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- CHEVRON 2 (Router → WAN) -->
                <Canvas Width="28" Height="16" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Visibility="{Binding HasGateway, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="6,0">
                    <Line X1="2" Y1="8" X2="24" Y2="8" Stroke="#4fc3f7" StrokeThickness="2"/>
                    <Polygon Points="24,2 28,8 24,14" Fill="#4fc3f7"/>
                </Canvas>

                <!-- NODE 3: WAN -->
                <Border Width="240" Height="168" Background="#080f14"
                        BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6" Padding="6">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <Canvas Width="32" Height="32">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="30" Height="30"
                                         Stroke="#4fc3f7" StrokeThickness="1" Fill="Transparent"/>
                                <Ellipse Canvas.Left="7" Canvas.Top="1" Width="18" Height="30"
                                         Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                                <Line X1="4"  Y1="9"  X2="28" Y2="9"  Stroke="#4fc3f7" StrokeThickness="0.6" Opacity="0.45"/>
                                <Line X1="1"  Y1="16" X2="31" Y2="16" Stroke="#4fc3f7" StrokeThickness="0.7" Opacity="0.55"/>
                                <Line X1="4"  Y1="23" X2="28" Y2="23" Stroke="#4fc3f7" StrokeThickness="0.6" Opacity="0.45"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="WAN" FontSize="9" FontWeight="Bold"
                                   Foreground="#4fc3f7" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding Wan.Ip, FallbackValue='—'}"
                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Wan.Isp, FallbackValue='—'}"
                                   FontSize="8" Foreground="#6A9AAA" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Wan.Country, FallbackValue=''}"
                                   FontSize="8" Foreground="#5A8AAA" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,0,3"/>
                        <!-- Ping-tider -->
                        <Rectangle Height="1" Fill="#1a3040" Width="160" Margin="0,0,0,3"/>
                        <ItemsControl ItemsSource="{Binding InternetChecks}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="160" Margin="0,0.5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#2A1A1A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                                <Setter Property="Fill" Value="#2A3A4A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Host}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#5A7A8A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LatencyDisplay}" FontFamily="Consolas" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#3A5060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- NIVEAU 2: BEVIS (GATEWAY + INTERNET) — RESIZABLE  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="100"/>  <!-- Gateway -->
                <ColumnDefinition Width="6"/>                  <!-- Splitter -->
                <ColumnDefinition Width="1*" MinWidth="100"/>  <!-- Internet -->
                <ColumnDefinition Width="6"/>                  <!-- Splitter -->
                <ColumnDefinition Width="0" MinWidth="0"/>     <!-- Buffer for resize -->
            </Grid.ColumnDefinitions>

            <!-- GATEWAY-KORT -->
            <Border Grid.Column="0" Background="#080f14" BorderBrush="#1a3040"
                    BorderThickness="0.5" CornerRadius="6" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Gateway" FontFamily="Consolas" FontSize="11"
                                   Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding GatewayCheck.LatencyDisplay}"
                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                   Foreground="#64B5F6" Margin="0,2,0,6"/>
                    </StackPanel>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding GatewaySeries.Values}"
                                               Stroke="#4CAF50" Margin="0,0,0,6"
                                               Visibility="{Binding GraphsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="2" FontFamily="Consolas" FontSize="10" Foreground="#3A5A6A"
                               Visibility="{Binding GraphsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="Jitter: "/><Run Text="{Binding GatewaySeries.JitterDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                        <Run Text=" · Tab: "/><Run Text="{Binding GatewaySeries.LossDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Splitter 1 (midt mellom Gateway og Internet) -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A2A3A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- INTERNET-KORT -->
            <Border Grid.Column="2" Background="#080f14" BorderBrush="#1a3040"
                    BorderThickness="0.5" CornerRadius="6" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Internet" FontFamily="Consolas" FontSize="11"
                                   Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding WanSeries.CurrentDisplay}"
                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                   Foreground="#64B5F6" Margin="0,2,0,6"/>
                    </StackPanel>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding WanSeries.Values}"
                                               Stroke="#64B5F6" Margin="0,0,0,6"
                                               Visibility="{Binding GraphsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="2" FontFamily="Consolas" FontSize="10" Foreground="#3A5A6A"
                               Visibility="{Binding GraphsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="Jitter: "/><Run Text="{Binding WanSeries.JitterDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                        <Run Text=" · Tab: "/><Run Text="{Binding WanSeries.LossDisplay, Mode=OneWay}" Foreground="#5A8AAA"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Splitter 2 (høj kant på Internet for at vokse) -->
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A2A3A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Buffer-kolonne for Internet resize -->
            <Border Grid.Column="4" Background="Transparent"/>
        </Grid>

        <!-- Vertikal resize-handle mellem Gateway/Internet og Hastighed -->
        <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A2A3A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- NIVEAU 3: DETALJER (EXPANDER)                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="#06111a" CornerRadius="4" BorderBrush="#1a3040"
                BorderThickness="0.5" Padding="14,10">
            <StackPanel>
                <!-- SAMMENFOLDET HEADER: chevron+Detaljer, IPv6/portal-info, mellemrum, Hastighed -->
                <Grid Visibility="{Binding DiagnosticsVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Background="Transparent"
                            BorderThickness="0" Padding="0" Margin="0" Cursor="Hand"
                            Command="{Binding ToggleDiagnosticsCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="14" Height="14"
                                                     Foreground="#3A6A9A" VerticalAlignment="Center"
                                                     Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </materialDesign:PackIcon.RenderTransform>
                            </materialDesign:PackIcon>
                            <TextBlock Text="Detaljer" FontFamily="Consolas" FontSize="12"
                                       Foreground="#64B5F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#5A8AAA"
                               VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                        <Run Text="IPv6: "/><Run Text="{Binding Ipv6Text, Mode=OneWay}" Foreground="#7AAACA"/>
                        <Run Text=" · "/><Run Text="{Binding PortalText, Mode=OneWay}" Foreground="#7AAACA"/>
                    </TextBlock>

                    <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <Run Text="Hastighed: " FontWeight="SemiBold" Foreground="#64B5F6"/>
                        <Run Text="{Binding SpeedTestDownText, Mode=OneWay}" FontWeight="Bold" Foreground="#64B5F6"/>
                    </TextBlock>
                </Grid>

                <!-- Toggle-chevron når udfoldet (headerlinje bliver til simpel titel + kort nedenfor) -->
                <Button HorizontalContentAlignment="Left" Background="Transparent"
                        BorderThickness="0" Padding="0" Margin="0"  Cursor="Hand"
                        Command="{Binding ToggleDiagnosticsCommand}"
                        Visibility="{Binding DiagnosticsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="14" Height="14"
                                                 Foreground="#3A6A9A" VerticalAlignment="Center"
                                                 Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </materialDesign:PackIcon.RenderTransform>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Detaljer" FontFamily="Consolas" FontSize="12"
                                   Foreground="#64B5F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- UDFOLDET: tre kort (DHCP-LEASE / IPV6+PORTAL / HASTIGHEDSTEST), v1.3.45-stil -->
                <WrapPanel Margin="0,10,0,0"
                           Visibility="{Binding DiagnosticsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- DHCP-LEASE -->
                    <Border Background="#0A1A26" CornerRadius="4" BorderBrush="#1a3040"
                            BorderThickness="0.5" Padding="12,8" Width="250" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="DHCP-LEASE" FontFamily="Consolas" FontSize="13"
                                       Foreground="#3A6A9A" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel Visibility="{Binding DhcpIsDhcp, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,1.5">
                                    <TextBlock Text="DHCP-server" FontSize="11" Foreground="#3A5A6A"/>
                                    <TextBlock Text="{Binding DhcpServerText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="#64B5F6" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1.5">
                                    <TextBlock Text="Tildelt" FontSize="11" Foreground="#3A5A6A"/>
                                    <TextBlock Text="{Binding DhcpObtainedText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="#5A8AAA" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,1.5">
                                    <TextBlock Text="Udløber" FontSize="11" Foreground="#3A5A6A"/>
                                    <TextBlock Text="{Binding DhcpExpiresText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="#5A8AAA" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="Statisk IP — ingen lease" FontSize="11" Foreground="#3A5A6A"
                                       Visibility="{Binding DhcpIsDhcp, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- IPv6 + Captive Portal -->
                    <Border Background="#0A1A26" CornerRadius="4" BorderBrush="#1a3040"
                            BorderThickness="0.5" Padding="12,8" Width="250" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="IPV6 + PORTAL" FontFamily="Consolas" FontSize="13"
                                       Foreground="#3A6A9A" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#5C5C2A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ipv6Ok}" Value="True">
                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11" Foreground="#5A8AAA">
                                    <Run Text="IPv6: "/><Run Text="{Binding Ipv6Text, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PortalWarning}" Value="True">
                                                    <Setter Property="Fill" Value="#FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PortalText}" FontSize="11" Foreground="#5A8AAA"
                                           TextWrapping="Wrap" MaxWidth="200"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hastighedstest -->
                    <Border Background="#0A1A26" CornerRadius="4" BorderBrush="#1a3040"
                            BorderThickness="0.5" Padding="12,8" Width="250" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="HASTIGHEDSTEST" FontFamily="Consolas" FontSize="13"
                                       Foreground="#3A6A9A" FontWeight="Bold" Margin="0,0,0,6"/>
                            <WrapPanel Visibility="{Binding HasSpeedTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding SpeedTestDownText}" FontFamily="Consolas" FontSize="12"
                                           FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SpeedTestUpText}" FontFamily="Consolas" FontSize="12"
                                           FontWeight="Bold" Foreground="#64B5F6"
                                           ToolTip="Upload er et estimat — hele POST-requesten times"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding SpeedTestTimeText}" FontSize="9" Foreground="#3A5A6A"
                                       Margin="0,2,0,4"
                                       Visibility="{Binding HasSpeedTestResult, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ProgressBar Height="3" Margin="0,2,0,4" Maximum="100"
                                         Value="{Binding SpeedTestProgressPercent, Mode=OneWay}"
                                         Foreground="#1565C0" Background="#0C1A2C" BorderThickness="0"
                                         Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SpeedTestPhaseText}" FontFamily="Consolas" FontSize="10"
                                       Foreground="#5A8AAA" Margin="0,0,0,4"
                                       Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="24" Padding="10,0" Margin="0" HorizontalAlignment="Left"
                                    Command="{Binding TestSpeedCommand}"
                                    Content="{Binding SpeedTestButtonText}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- NIVEAU 3: KENDTE ENHEDER (EXPANDER)               -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="8" Background="#06111a" CornerRadius="4" BorderBrush="#1a3040"
                BorderThickness="0.5" Padding="14,10">
            <StackPanel>
                <Button HorizontalContentAlignment="Stretch" Background="Transparent"
                        BorderThickness="0" Padding="0" Margin="0" Cursor="Hand"
                        Command="{Binding ToggleDevicesCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="ChevronRight" Width="14" Height="14"
                                                 Foreground="#3A6A9A" VerticalAlignment="Center"
                                                 Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </materialDesign:PackIcon.RenderTransform>
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DevicesVisible}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Grid.Column="1" Text="Kendte enheder" FontFamily="Consolas" FontSize="12"
                                   Foreground="#64B5F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding TotalNearby, Mode=OneWay}"
                                   FontSize="10" Foreground="#5A8AAA" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </Grid>
                </Button>

                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding DevicesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="10" Foreground="#3A5A6A" Margin="0,0,0,8">
                        <Run Text="{Binding TotalNearby, Mode=OneWay}"/> <Run Text="enheder i"/>
                        <Run Text="{Binding NearbyGroups.Count, Mode=OneWay}"/> <Run Text="subnet(s)"/>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding NearbyGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="4">
                                    <StackPanel>
                                        <!-- Gruppe-header (subnet), klikbar toggle -->
                                        <Button Command="{Binding ToggleCommand}" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch" Focusable="False"
                                                Background="Transparent" BorderThickness="0" Padding="10,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Kind="ChevronRight" Width="12" Height="12"
                                                                         Foreground="#3A6A9A" VerticalAlignment="Center"
                                                                         Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                    <materialDesign:PackIcon.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </materialDesign:PackIcon.RenderTransform>
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="#64B5F6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Devices.Count}" FontFamily="Consolas"
                                                           FontSize="10" Foreground="#5A8AAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Grid.Column="4" Background="#3A2A10" CornerRadius="3" Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NewCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#FF9800">
                                                        <Run Text="{Binding NewCount, Mode=OneWay}"/><Run Text=" NYE"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <!-- Kolonne-header, kun synlig når udfoldet -->
                                        <Grid Background="#0C1520" Height="22"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="148"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="IP-adresse" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#3A6A9A" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="MAC-adresse" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#3A6A9A" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Vendor / Producent" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#3A6A9A" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Enheds-liste -->
                                        <ItemsControl ItemsSource="{Binding Devices}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#0C1520" BorderThickness="0,1,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                        <Setter Property="Background" Value="#2A1E0D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Height="24">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="148"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding IpAddress}"
                                                                       FontFamily="Consolas" FontSize="11"
                                                                       Foreground="#64B5F6" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding MacAddress}"
                                                                       FontFamily="Consolas" FontSize="10"
                                                                       Foreground="#3A5A6A" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Vendor}"
                                                                       FontSize="11" Foreground="#5A8AAA"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0"
                                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Border Background="#3A2A10" CornerRadius="3" Padding="6,1"
                                                                        VerticalAlignment="Center" ToolTip="{Binding FirstSeenDisplay}">
                                                                    <TextBlock Text="NY" FontFamily="Consolas" FontSize="9"
                                                                               FontWeight="Bold" Foreground="#FF9800"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- "DIAGNOSTICÉR NU"                                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="10" Background="#06111a" CornerRadius="4" BorderBrush="#1a3040"
                BorderThickness="0.5" Padding="14,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Stethoscope" Width="18" Height="18"
                                                 Foreground="#4a90e2" VerticalAlignment="Center"/>
                        <TextBlock Text="Diagnosticér nu" FontSize="14" FontWeight="Bold"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Finder automatisk hvor et netværksproblem ligger"
                                   Foreground="#5A8AAA" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Diagnosticér nu" Style="{StaticResource DarkButtonStyle}"
                            Width="140" HorizontalAlignment="Right"
                            Command="{Binding RunDiagnosisCommand}"
                            IsEnabled="{Binding IsDiagnosing, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>

                <!-- Trin med live fremdrift -->
                <ItemsControl ItemsSource="{Binding DiagnosisSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="12" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5A8AAA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" FontSize="11" Foreground="#DDDDDD"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="#8fa3bf" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Konklusion -->
                <Border Background="#0D1520" CornerRadius="4" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding HasDiagnosisResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DiagnosisConclusion}" FontWeight="Bold" FontSize="13"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DiagnosisRecommendation}" FontSize="12"
                                   Foreground="#8fa3bf" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Kopiér rapport" Style="{StaticResource DarkButtonStyle}"
                                HorizontalAlignment="Left" Width="130"
