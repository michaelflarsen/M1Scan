<UserControl x:Class="M1Scan.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: header -->
            <RowDefinition Height="10"/>    <!-- 1: spacer -->
            <RowDefinition Height="Auto"/>  <!-- 2: WAN chain -->
            <RowDefinition Height="8"/>     <!-- 3: spacer -->
            <RowDefinition Height="38"/>    <!-- 4: ping bar -->
            <RowDefinition Height="10"/>    <!-- 5: spacer -->
            <RowDefinition Height="Auto"/>  <!-- 6: adapter cards -->
            <RowDefinition Height="14"/>    <!-- 7: spacer -->
            <RowDefinition Height="*"/>     <!-- 8: known devices -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- HEADER                                                 -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="// STATUS" FontFamily="Consolas" FontSize="10"
                           Foreground="#1565C0" FontWeight="SemiBold"/>
                <TextBlock Text="Netværksoverblik" FontSize="20" FontWeight="Bold"
                           Foreground="White" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#3A4A5A" Margin="0,0,12,0">
                    <Run Text="Sidst opdateret: "/>
                    <Run Text="{Binding LastRefreshed}"/>
                </TextBlock>

                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="28" Padding="12,0" Margin="0,0,10,0"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Opdater" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Border CornerRadius="4" Padding="10,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A1212"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Background" Value="#0D2010"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#5C2A2A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="OFFLINE"/>
                                    <Setter Property="Foreground" Value="#7A3A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Text"       Value="ONLINE"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- WAN TOPOLOGY CHAIN                                     -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/> <!-- NODE 1: WAN -->
                <ColumnDefinition Width="44"/>  <!-- Connector -->
                <ColumnDefinition Width="200"/> <!-- NODE 2: ROUTER -->
                <ColumnDefinition Width="44"/>  <!-- Connector -->
                <ColumnDefinition Width="200"/> <!-- NODE 3: ADAPTER -->
            </Grid.ColumnDefinitions>

            <!-- ── NODE 1: WAN ── -->
            <Border Grid.Column="0" Height="108" Background="#080f14"
                    BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Wan.IsLoading}" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Globe icon -->
                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Canvas Width="32" Height="32">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="30" Height="30"
                                     Stroke="#4fc3f7" StrokeThickness="1" Fill="Transparent"/>
                            <Ellipse Canvas.Left="7" Canvas.Top="1" Width="18" Height="30"
                                     Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                            <Ellipse Canvas.Left="12" Canvas.Top="1" Width="8" Height="30"
                                     Stroke="#4fc3f7" StrokeThickness="0.6" Fill="Transparent" Opacity="0.5"/>
                            <Line X1="4"  Y1="9"  X2="28" Y2="9"  Stroke="#4fc3f7" StrokeThickness="0.6" Opacity="0.45"/>
                            <Line X1="1"  Y1="16" X2="31" Y2="16" Stroke="#4fc3f7" StrokeThickness="0.7" Opacity="0.55"/>
                            <Line X1="4"  Y1="23" X2="28" Y2="23" Stroke="#4fc3f7" StrokeThickness="0.6" Opacity="0.45"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="WAN" FontSize="9" FontWeight="Bold"
                               Foreground="#4fc3f7" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="{Binding Wan.Ip}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Wan.IsLoading}" Value="True">
                                        <Setter Property="Foreground" Value="#2A4060"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Wan.Isp}" FontSize="9" Foreground="#2A4A5A"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="190" Margin="6,2,6,0"/>
                    <TextBlock FontSize="9" Foreground="#1E3A4A"
                               HorizontalAlignment="Center" MaxWidth="190" Margin="6,1,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Wan.Country}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Wan.IsLoading}" Value="True">
                                        <Setter Property="Text" Value=""/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Connector 1 → 2 -->
            <Grid Grid.Column="1">
                <Rectangle Height="1" Fill="#1a3040" VerticalAlignment="Center"/>
                <Path Data="M 0,-4 L 7,0 L 0,4 Z" Fill="#1a3040"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </Grid>

            <!-- ── NODE 2: ROUTER ── -->
            <Border Grid.Column="2" Height="108" Background="#080f14"
                    BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Router icon -->
                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Canvas Width="32" Height="32">
                            <!-- Router body -->
                            <Rectangle Canvas.Left="3" Canvas.Top="14" Width="26" Height="11"
                                       Stroke="#4fc3f7" StrokeThickness="1" Fill="Transparent"/>
                            <!-- Left antenna -->
                            <Line X1="9"  Y1="14" X2="8"  Y2="4" Stroke="#4fc3f7" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="6"  Canvas.Top="2" Width="4" Height="4"
                                     Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                            <!-- Center antenna -->
                            <Line X1="16" Y1="14" X2="16" Y2="2" Stroke="#4fc3f7" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="0" Width="4" Height="4"
                                     Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                            <!-- Right antenna -->
                            <Line X1="23" Y1="14" X2="24" Y2="4" Stroke="#4fc3f7" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="22" Canvas.Top="2" Width="4" Height="4"
                                     Stroke="#4fc3f7" StrokeThickness="0.8" Fill="Transparent"/>
                            <!-- LED dots on body -->
                            <Ellipse Canvas.Left="6"  Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.7"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.4"/>
                            <Ellipse Canvas.Left="22" Canvas.Top="18" Width="4" Height="4" Fill="#4fc3f7" Opacity="0.2"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="ROUTER" FontSize="9" FontWeight="Bold"
                               Foreground="#4fc3f7" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding GatewayCheck.Host, FallbackValue='—'}"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding GatewayCheck.LatencyDisplay, FallbackValue='—'}"
                               FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2A4060"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GatewayCheck.IsOnline}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GatewayCheck.IsChecking}" Value="False"/>
                                            <Condition Binding="{Binding GatewayCheck.IsOnline}"   Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#7A2020"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Connector 2 → 3 -->
            <Grid Grid.Column="3">
                <Rectangle Height="1" Fill="#1a3040" VerticalAlignment="Center"/>
                <Path Data="M 0,-4 L 7,0 L 0,4 Z" Fill="#1a3040"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </Grid>

            <!-- ── NODE 3: AKTIV ADAPTER ── -->
            <Border Grid.Column="4" Height="108" Background="#080f14"
                    BorderBrush="#1a3040" BorderThickness="0.5" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#1a3040"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DefaultAdapter.IsDefaultRoute}" Value="True">
                                <Setter Property="BorderBrush" Value="#1A4A30"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Monitor/adapter icon -->
                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Canvas Width="32" Height="32">
                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="28" Height="19"
                                       Stroke="#4CAF50" StrokeThickness="1" Fill="Transparent"/>
                            <Rectangle Canvas.Left="5" Canvas.Top="5" Width="22" Height="13"
                                       Fill="#071207"/>
                            <!-- Signal bars -->
                            <Rectangle Canvas.Left="10"   Canvas.Top="14" Width="3" Height="3" Fill="#4CAF50" Opacity="0.4"/>
                            <Rectangle Canvas.Left="14.5" Canvas.Top="12" Width="3" Height="5" Fill="#4CAF50" Opacity="0.65"/>
                            <Rectangle Canvas.Left="19"   Canvas.Top="10" Width="3" Height="7" Fill="#4CAF50" Opacity="0.9"/>
                            <!-- Stand -->
                            <Line X1="16" Y1="21" X2="16" Y2="26" Stroke="#4CAF50" StrokeThickness="1.5"/>
                            <!-- Base -->
                            <Line X1="9" Y1="26" X2="23" Y2="26" Stroke="#4CAF50" StrokeThickness="1.5"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding DefaultAdapter.Name, FallbackValue='ADAPTER'}"
                               FontSize="9" FontWeight="Bold" Foreground="#4CAF50"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="190" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding DefaultAdapter.IpAddress, FallbackValue='—'}"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DefaultAdapter.SubnetMask, FallbackValue='—'}"
                               FontFamily="Consolas" FontSize="9" Foreground="#1E4A2A"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding DefaultAdapter.Description, FallbackValue='—'}"
                               FontSize="9" Foreground="#2A4A3A"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="190" Margin="6,1,6,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- PING BAR                                               -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#06111a" CornerRadius="4"
                BorderBrush="#1a3040" BorderThickness="0.5">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding InternetChecks}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#2A1A1A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}"  Value="True">
                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                    <Setter Property="Fill" Value="#2A3A4A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Host}" FontFamily="Consolas" FontSize="11"
                                           Foreground="#3A5060" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding LatencyDisplay}" FontFamily="Consolas" FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2A3A4A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}"  Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                    <Setter Property="Foreground" Value="#2A3A4A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="1" CornerRadius="3" Padding="9,4" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#180E0E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Background" Value="#0D1E10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#4A1A1A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="OFFLINE"/>
                                    <Setter Property="Foreground" Value="#6A2A2A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Text"       Value="ONLINE"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- MINE ADAPTERE                                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="// MINE ADAPTERE" FontFamily="Consolas" FontSize="10"
                       Foreground="#1565C0" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding ActiveAdapters}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveAdapters.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="14,12" Margin="0,0,12,12" Width="200"
                                             materialDesign:ElevationAssist.Elevation="Dp2">
                            <materialDesign:Card.Style>
                                <Style TargetType="materialDesign:Card">
                                    <Setter Property="Background"      Value="#151E2C"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefaultRoute}" Value="True">
                                            <Setter Property="Background"      Value="#0C1A2C"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush"     Value="#1A4A80"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:Card.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Ellipse Width="7" Height="7" Fill="#4CAF50"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               Foreground="#5A7A9A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding IpAddress}"
                                           FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                           Foreground="#64B5F6"/>
                                <TextBlock Text="{Binding SubnetMask}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#3A5A6A" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="GW " FontFamily="Consolas" FontSize="11" Foreground="#2A3A4A"/>
                                    <TextBlock Text="{Binding Gateway}"
                                               FontFamily="Consolas" FontSize="11" Foreground="#3A6A5A"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="10"
                                           Foreground="#2A3A4A" TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ingen aktiv adapter -->
            <materialDesign:Card Background="#0E1520" Padding="14,12" MinWidth="190"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveAdapters.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="7" Height="7" Fill="#5C2A2A"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Ingen forbindelse" FontSize="11" Foreground="#4A3A3A"/>
                    </StackPanel>
                    <TextBlock Text="Ingen Aktiv Adapter"
                               FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                               Foreground="#3A3A4A"/>
                    <TextBlock Text="Kontroller netværksforbindelsen"
                               FontSize="10" Foreground="#2A2A3A" Margin="0,5,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- NÆRLIGGENDE ENHEDER — GRUPPERT PER SUBNET             -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="// KENDTE ENHEDER  —  ARP cache (ikke live scan)"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#1565C0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock FontFamily="Consolas" FontSize="10"
                           Foreground="#2A3A4A" VerticalAlignment="Center">
                    <Run Text="  —  "/>
                    <Run Text="{Binding TotalNearby, Mode=OneWay}"/>
                    <Run Text=" enheder i "/>
                    <Run Text="{Binding NearbyGroups.Count, Mode=OneWay}"/>
                    <Run Text=" subnet(s)"/>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NearbyGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" BorderBrush="#1C2A3A" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <Button Command="{Binding ToggleCommand}"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#111C2A" CornerRadius="4,4,0,0" Padding="12,7">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0"
                                                                     Kind="ChevronRight" Width="14" Height="14"
                                                                     Foreground="#3A6A9A" VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"
                                                                     RenderTransformOrigin="0.5,0.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </materialDesign:PackIcon.RenderTransform>
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <materialDesign:PackIcon Grid.Column="1"
                                                                     Kind="NetworkOutline" Width="14" Height="14"
                                                                     Foreground="#1565C0" VerticalAlignment="Center"
                                                                     Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Display}"
                                                       FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#64B5F6" VerticalAlignment="Center"/>

                                            <Border Grid.Column="3"
                                                    Background="#0D1E30" CornerRadius="10"
                                                    Padding="7,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AdapterName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="EthernetCable" Width="11" Height="11"
                                                                             Foreground="#1565C0" VerticalAlignment="Center"
                                                                             Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding AdapterName}"
                                                               FontFamily="Consolas" FontSize="10"
                                                               Foreground="#3A6A9A" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="4"
                                                    Background="#0D1E30" CornerRadius="10"
                                                    Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#3A6A9A">
                                                    <Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                                                    <Run Text=" enheder"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Grid Background="#0C1520" Height="24"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="148"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="IP-adresse"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#444444"
                                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="MAC-adresse"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#444444"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Vendor / Producent"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#444444"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Devices}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#0C1520" BorderThickness="0,1,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0E1A28"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="148"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding IpAddress}"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   Foreground="#64B5F6" VerticalAlignment="Center"
                                                                   Margin="14,0,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding MacAddress}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   Foreground="#3A5060" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Vendor}"
                                                                   FontSize="12" Foreground="#AAAAAA"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
